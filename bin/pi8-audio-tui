def draw_presets_scenes(stdscr, scenes: list[dict], sel: int, status: str) -> None:
    stdscr.erase()
    my, mx = stdscr.getmaxyx()
    safe_addstr(stdscr, 0, 0, "Presets — Scenes", curses.A_BOLD)
    safe_addstr(stdscr, 1, 0, _trunc("Enter apply  e edit file  r refresh  q back", mx), curses.A_DIM)
    row = 3
    if not scenes:
        safe_addstr(stdscr, row, 0, "(no scenes — edit JSON or use web /m)", 0)
    for i, sc in enumerate(scenes[: max(1, my - 8)]):
        if row >= my - 4:
            break
        name = sc.get("name", "?")
        label = sc.get("label") or ""
        line = f" {name}"
        if label:
            line += f" — {label}"
        att = curses.A_REVERSE if i == sel else 0
        safe_addstr(stdscr, row, 0, _trunc(line, mx), att)
        row += 1
    if status:
        safe_addstr(stdscr, my - 3, 0, _trunc(status, mx), 0)
    safe_addstr(stdscr, my - 1, 0, _trunc("Scenes", mx), curses.A_DIM)


