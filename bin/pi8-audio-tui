def merge_dashboard_body(errors: list[str], lines: list[str]) -> tuple[list[str], int]:
    """Body lines and count of leading error lines (for bold); blank separator not counted."""
    body: list[str] = []
    n_err = len(errors)
    body.extend(errors)
    if errors:
        body.append("")
    body.extend(lines)
    return body, n_err


def draw_dashboard(
    stdscr, body: list[str], err_line_count: int, scroll: int
) -> None:
    stdscr.erase()
    my, mx = stdscr.getmaxyx()
    safe_addstr(stdscr, 0, 0, "Dashboard", curses.A_BOLD)
    safe_addstr(
        stdscr,
        1,
        0,
        _trunc("r refresh  ↑/↓ scroll  q menu", mx),
        curses.A_DIM,
    )
    header_rows = 2
    footer_rows = 1
    avail = max(0, my - header_rows - footer_rows)
    max_scroll = max(0, len(body) - avail)
    s = min(max(0, scroll), max_scroll)
    slice_body = body[s : s + avail]
    for i, ln in enumerate(slice_body):
        if 2 + i < my - footer_rows:
            idx = s + i
            att = curses.A_BOLD if idx < err_line_count else 0
            safe_addstr(stdscr, 2 + i, 0, ln, att)
    if len(body) > avail:
        safe_addstr(
            stdscr,
            my - 1,
            0,
            _trunc(f"scroll {s}-{s + len(slice_body)}/{len(body)}", mx),
            curses.A_DIM,
        )
    else:
        safe_addstr(stdscr, my - 1, 0, _trunc("end", mx), curses.A_DIM)


def apply_menu_selection(sel: int) -> str | None:
    """Return next view name, or None to quit."""
    if sel == 0:
        return "dashboard"
    if sel == 6:
        return None
    return ["audio", "display_menu", "presets_menu", "system_menu", "tools_menu"][sel - 1]


def run(stdscr) -> None:
    curses.curs_set(0)
    stdscr.nodelay(False)
    view = "menu"
    menu_sel = 0
    dash_body: list[str] = []
    dash_err_n = 0
    dash_scroll = 0

    audio_menu_sel = 0
    audio_status = ""

    # Outputs screen local state (refreshed on entry / 'r')
    out_fr = True
    hdmi_en = False
    hdmi_port = 0

    # Network config edit buffer
    net_cfg: dict = {}

    # Sync delay
    sync_sel = 0  # 0 none, 1 front, 2 rear
    sync_delay_ms = 0.0

    # Buffers: indices into BUFFER_PRESETS
    buf_i_front = 3  # 2048 default
    buf_i_rear = 1  # 512 default

    display_menu_sel = 0
    presets_menu_sel = 0
    tools_menu_sel = 0
    display_status = ""
    presets_status = ""
    system_status = ""
    tools_status = ""

    dq_mode_i = 0
    dq_overlay = True
    dq_mirror = False
    dq_lyrics = False
    dq_theme_i = 0

    sleep_active = False
    sleep_remaining_s = 0

    scenes_list: list = []
    scene_sel = 0

    legacy_names: list[str] = []
    legacy_sel = 0

    tools_calib_vol = 70.0
    tools_calib_fo = 0.0
    tools_calib_ro = 0.0

    def refresh_dashboard() -> None:
        nonlocal dash_body, dash_err_n, dash_scroll
        mx = stdscr.getmaxyx()[1]
        lines, errors = collect_dashboard_lines(mx)
        dash_body, dash_err_n = merge_dashboard_body(errors, lines)
        dash_scroll = 0

    def load_outputs_from_state() -> None:
        nonlocal out_fr, hdmi_en, hdmi_port
        st = pi8_audio_http.get_state()
        out_fr = bool(st.get("outputs_front_rear", True))
        hdmi_en = bool(st.get("hdmi_enabled", False))
        hdmi_port = int(st.get("hdmi_port", 0) or 0)

    def load_net_cfg_from_api() -> None:
        nonlocal net_cfg
        try:
            ns = pi8_audio_http.get_network_status()
            cfg = dict(ns.get("config") or {})
            net_cfg = {
                "group": str(cfg.get("group", "239.255.77.77")),
                "port": int(cfg.get("port", 4010)),
                "iface": str(cfg.get("iface", "")),
                "unicast": bool(cfg.get("unicast", False)),
                "rate": int(cfg.get("rate", 48000)),
                "format": str(cfg.get("format", "s16")),
            }
        except (pi8_audio_http.Pi8AudioHttpError, OSError, TypeError, ValueError):
            net_cfg = {
                "group": "239.255.77.77",
                "port": 4010,
                "iface": "",
                "unicast": False,
                "rate": 48000,
                "format": "s16",
            }

    def load_buffer_indices() -> None:
        nonlocal buf_i_front, buf_i_rear
        try:
            st = pi8_audio_http.get_state()
            bf = int(st.get("buffer_front", 2048))
            br = int(st.get("buffer_rear", 512))
            if bf in BUFFER_PRESETS:
                buf_i_front = BUFFER_PRESETS.index(bf)
            if br in BUFFER_PRESETS:
                buf_i_rear = BUFFER_PRESETS.index(br)
        except (pi8_audio_http.Pi8AudioHttpError, OSError, ValueError):
            pass

    def load_display_draft() -> None:
        nonlocal dq_mode_i, dq_overlay, dq_mirror, dq_lyrics, dq_theme_i
        try:
            d = pi8_audio_http.get_display_state()
            m = str(d.get("mode", "off"))
            if m in DISPLAY_MODES:
                dq_mode_i = DISPLAY_MODES.index(m)
            else:
                dq_mode_i = 0
            dq_overlay = bool(d.get("overlay_enabled", True))
            dq_mirror = bool(d.get("visualizer_mirror", False))
            dq_lyrics = bool(d.get("lyrics_enabled", False))
            th = str(d.get("visualizer_theme", "default"))
            if th in VIS_THEMES:
                dq_theme_i = VIS_THEMES.index(th)
            else:
                dq_theme_i = 0
        except (pi8_audio_http.Pi8AudioHttpError, OSError, TypeError, ValueError):
            pass

    def load_sleep_status() -> None:
        nonlocal sleep_active, sleep_remaining_s
        try:
            s = pi8_audio_http.get_sleep_timer()
            sleep_active = bool(s.get("active"))
            sleep_remaining_s = int(s.get("remaining_seconds", 0) or 0)
        except (pi8_audio_http.Pi8AudioHttpError, OSError, TypeError, ValueError):
            sleep_active = False
            sleep_remaining_s = 0

    def load_scenes() -> None:
        nonlocal scenes_list, scene_sel
        try:
            r = pi8_audio_http.get_scenes()
            scenes_list = list(r.get("scenes") or [])
            if scenes_list:
                scene_sel = min(scene_sel, len(scenes_list) - 1)
            else:
                scene_sel = 0
        except (pi8_audio_http.Pi8AudioHttpError, OSError):
            scenes_list = []
            scene_sel = 0

    def load_legacy_names() -> None:
        nonlocal legacy_names, legacy_sel
        try:
            r = pi8_audio_http.get_presets()
            presets = r.get("presets") or {}
            if isinstance(presets, dict):
                legacy_names = sorted(presets.keys())
            else:
                legacy_names = []
            if legacy_names:
                legacy_sel = min(legacy_sel, len(legacy_names) - 1)
            else:
                legacy_sel = 0
        except (pi8_audio_http.Pi8AudioHttpError, OSError):
            legacy_names = []
            legacy_sel = 0

    def target_from_sel() -> str | None:
        return [None, "front", "rear"][sync_sel]

    def draw_routing() -> None:
        stdscr.erase()
        my, mx = stdscr.getmaxyx()
        safe_addstr(stdscr, 0, 0, "Audio — Routing", curses.A_BOLD)
        mode = "?"
        try:
            st = pi8_audio_http.get_state()
            mode = str(st.get("mode", "?"))
        except (pi8_audio_http.Pi8AudioHttpError, OSError):
            pass
        safe_addstr(stdscr, 2, 0, _trunc(f"Current mode: {mode}", mx), 0)
        safe_addstr(stdscr, 4, 0, "1 = stereo   2 = surround   q = back", 0)
        if audio_status:
            safe_addstr(stdscr, my - 3, 0, _trunc(audio_status, mx), 0)
        safe_addstr(stdscr, my - 1, 0, _trunc("Routing", mx), curses.A_DIM)

    def draw_outputs() -> None:
        stdscr.erase()
        my, mx = stdscr.getmaxyx()
        safe_addstr(stdscr, 0, 0, "Audio — Outputs", curses.A_BOLD)
        safe_addstr(stdscr, 2, 0, _trunc(f"Front+rear: {'on' if out_fr else 'off'}", mx), 0)
        safe_addstr(stdscr, 3, 0, _trunc(f"HDMI enabled: {'on' if hdmi_en else 'off'}", mx), 0)
        safe_addstr(stdscr, 4, 0, _trunc(f"HDMI port: {hdmi_port} (0 or 1)", mx), 0)
        safe_addstr(stdscr, 6, 0, "f toggle front+rear  h toggle HDMI  p cycle port (0/1)", 0)
        safe_addstr(stdscr, 7, 0, "a apply (POST /hdmi)  r reload from state  q back", 0)
        if audio_status:
            safe_addstr(stdscr, my - 3, 0, _trunc(audio_status, mx), 0)
        safe_addstr(stdscr, my - 1, 0, _trunc("Outputs", mx), curses.A_DIM)

    def draw_source() -> None:
        stdscr.erase()
        my, mx = stdscr.getmaxyx()
        safe_addstr(stdscr, 0, 0, "Audio — Source", curses.A_BOLD)
        try:
            st = pi8_audio_http.get_state()
            cur = st.get("source", "?")
        except (pi8_audio_http.Pi8AudioHttpError, OSError):
            cur = "?"
        safe_addstr(stdscr, 2, 0, _trunc(f"Current: {cur}", mx), 0)
        safe_addstr(stdscr, 4, 0, "1 bluetooth  2 local  3 usb  4 network  q back", 0)
        if audio_status:
            safe_addstr(stdscr, my - 3, 0, _trunc(audio_status, mx), 0)
        safe_addstr(stdscr, my - 1, 0, _trunc("Source", mx), curses.A_DIM)

    def draw_network() -> None:
        stdscr.erase()
        my, mx = stdscr.getmaxyx()
        safe_addstr(stdscr, 0, 0, "Audio — Network (Scream)", curses.A_BOLD)
        row = 2
        try:
            ns = pi8_audio_http.get_network_status()
            for ln in fmt_network_status_summary(ns):
                safe_addstr(stdscr, row, 0, _trunc(ln, mx), 0)
                row += 1
                if row >= my - 8:
                    break
        except (pi8_audio_http.Pi8AudioHttpError, OSError) as e:
            safe_addstr(stdscr, row, 0, _trunc(f"status error: {e}", mx), 0)
            row += 1
        row += 1
        safe_addstr(stdscr, row, 0, "— Edit (saved fields) —", curses.A_DIM)
        row += 1
        safe_addstr(
            stdscr,
            row,
            0,
            _trunc(
                f"group={net_cfg.get('group')}  port={net_cfg.get('port')}  "
                f"iface={net_cfg.get('iface')!r}",
                mx,
            ),
            0,
        )
        row += 1
        safe_addstr(
            stdscr,
            row,
            0,
            _trunc(
                f"unicast={net_cfg.get('unicast')}  rate={net_cfg.get('rate')}  "
                f"format={net_cfg.get('format')}",
                mx,
            ),
            0,
        )
        row += 2
        safe_addstr(
            stdscr,
            row,
            0,
            "g group  p port  i iface  u unicast  t rate  f format  s save  r refresh  q back",
            0,
        )
        if audio_status:
            safe_addstr(stdscr, my - 3, 0, _trunc(audio_status, mx), 0)
        safe_addstr(stdscr, my - 1, 0, _trunc("Network", mx), curses.A_DIM)

    def draw_sync() -> None:
        stdscr.erase()
        my, mx = stdscr.getmaxyx()
        safe_addstr(stdscr, 0, 0, "Audio — Sync delay", curses.A_BOLD)
        names = ("none", "front", "rear")
        safe_addstr(
            stdscr,
            2,
            0,
            _trunc(f"Target: {names[sync_sel]}  Delay: {sync_delay_ms:g} ms", mx),
            0,
        )
        safe_addstr(stdscr, 4, 0, "n / f / r = target none|front|rear   +/- adjust 5 ms", 0)
        safe_addstr(stdscr, 5, 0, "d = set delay (0–500 ms)  a = apply (POST /apply)  q back", 0)
        if audio_status:
            safe_addstr(stdscr, my - 3, 0, _trunc(audio_status, mx), 0)
        safe_addstr(stdscr, my - 1, 0, _trunc("Sync", mx), curses.A_DIM)

    def draw_buffers() -> None:
        stdscr.erase()
        my, mx = stdscr.getmaxyx()
        safe_addstr(stdscr, 0, 0, "Audio — ALSA buffers", curses.A_BOLD)
        bf = BUFFER_PRESETS[buf_i_front]
        br = BUFFER_PRESETS[buf_i_rear]
        safe_addstr(stdscr, 2, 0, _trunc(f"Front: {bf}   Rear: {br}", mx), 0)
        safe_addstr(stdscr, 4, 0, "[ ] cycle front   { } cycle rear   a apply  r reload  q back", 0)
        if audio_status:
            safe_addstr(stdscr, my - 3, 0, _trunc(audio_status, mx), 0)
        safe_addstr(stdscr, my - 1, 0, _trunc("Buffers", mx), curses.A_DIM)

    def draw_levels() -> None:
        stdscr.erase()
        my, mx = stdscr.getmaxyx()
        safe_addstr(stdscr, 0, 0, "Audio — Levels", curses.A_BOLD)
        bal = vol = muted = "?"
        try:
            st = pi8_audio_http.get_state()
            bal = st.get("balance", "?")
        except (pi8_audio_http.Pi8AudioHttpError, OSError):
            pass
        try:
            v = pi8_audio_http.get_volume()
            vol = v.get("volume", "?")
            muted = v.get("muted", "?")
        except (pi8_audio_http.Pi8AudioHttpError, OSError):
            pass
        safe_addstr(stdscr, 2, 0, _trunc(f"Balance: {bal}  Volume: {vol}%  Muted: {muted}", mx), 0)
        safe_addstr(stdscr, 4, 0, "b balance  v volume  m mute toggle  r refresh  q back", 0)
        if audio_status:
            safe_addstr(stdscr, my - 3, 0, _trunc(audio_status, mx), 0)
        safe_addstr(stdscr, my - 1, 0, _trunc("Levels", mx), curses.A_DIM)

    while True:
        stdscr.timeout(-1)

        if view == "menu":
            draw_menu(stdscr, menu_sel)
        elif view == "dashboard":
            if not dash_body:
                refresh_dashboard()
            my, _ = stdscr.getmaxyx()
            avail = max(0, my - 3)
            max_scroll = max(0, len(dash_body) - avail)
            dash_scroll = min(dash_scroll, max_scroll)
            draw_dashboard(stdscr, dash_body, dash_err_n, dash_scroll)
        elif view == "audio":
            draw_audio_menu(stdscr, audio_menu_sel, audio_status)
        elif view == "audio_routing":
            draw_routing()
        elif view == "audio_outputs":
            draw_outputs()
        elif view == "audio_source":
            draw_source()
        elif view == "audio_network":
            draw_network()
        elif view == "audio_sync":
            draw_sync()
        elif view == "audio_buffers":
            draw_buffers()
        elif view == "audio_levels":
            draw_levels()
        elif view == "display_menu":
            draw_submenu(
                stdscr,
                "Display",
                DISPLAY_MENU,
                display_menu_sel,
                display_status,
                "Display",
            )
        elif view == "display_quick":
            draw_display_quick(
                stdscr,
                DISPLAY_MODES[dq_mode_i],
                dq_overlay,
                dq_mirror,
                dq_lyrics,
                VIS_THEMES[dq_theme_i],
                display_status,
            )
        elif view == "display_sleep":
            draw_display_sleep(stdscr, sleep_active, sleep_remaining_s, display_status)
        elif view == "display_raw":
            draw_display_raw(stdscr, display_status)
        elif view == "presets_menu":
            draw_submenu(
                stdscr,
                "Presets",
                PRESETS_MENU,
                presets_menu_sel,
                presets_status,
                "Presets",
            )
        elif view == "presets_scenes":
            draw_presets_scenes(stdscr, scenes_list, scene_sel, presets_status)
        elif view == "presets_legacy":
            draw_presets_legacy(stdscr, legacy_names, legacy_sel, presets_status)
        elif view == "system_menu":
            draw_system_menu(stdscr, system_status)
        elif view == "tools_menu":
            draw_tools_menu(stdscr, tools_menu_sel, tools_status)
        elif view == "tools_calib":
            draw_tools_calib(
                stdscr, tools_calib_vol, tools_calib_fo, tools_calib_ro, tools_status
            )
        elif view == "tools_sync":
            draw_tools_sync(stdscr, tools_status)
        else:
            return

        ch = stdscr.getch()

        if view == "menu":
            if ch in (ord("q"), ord("Q")):
                return
            if ch == curses.KEY_UP and menu_sel > 0:
                menu_sel -= 1
            elif ch == curses.KEY_DOWN and menu_sel < len(MENU_LABELS) - 1:
                menu_sel += 1
            elif ord("1") <= ch <= ord("7"):
                menu_sel = ch - ord("1")
                dest = apply_menu_selection(menu_sel)
                if dest is None:
                    return
                view = dest
                if view == "dashboard":
                    refresh_dashboard()
                elif view == "audio":
                    audio_menu_sel = 0
                elif view == "display_menu":
                    display_menu_sel = 0
                    display_status = ""
                elif view == "presets_menu":
                    presets_menu_sel = 0
                    presets_status = ""
                elif view == "system_menu":
                    system_status = ""
                elif view == "tools_menu":
                    tools_menu_sel = 0
                    tools_status = ""
            elif ch in (10, 13):
                dest = apply_menu_selection(menu_sel)
                if dest is None:
                    return
                view = dest
                if view == "dashboard":
                    refresh_dashboard()
                elif view == "audio":
                    audio_menu_sel = 0
                elif view == "display_menu":
                    display_menu_sel = 0
                    display_status = ""
                elif view == "presets_menu":
                    presets_menu_sel = 0
                    presets_status = ""
                elif view == "system_menu":
                    system_status = ""
                elif view == "tools_menu":
                    tools_menu_sel = 0
                    tools_status = ""
            continue

        if view == "dashboard":
            if ch in (ord("q"), ord("Q")):
                view = "menu"
                continue
            if ch == ord("r"):
                refresh_dashboard()
                continue
            my = stdscr.getmaxyx()[0]
            avail = max(0, my - 3)
            total = len(dash_body)
            max_scroll = max(0, total - avail)
            if ch == curses.KEY_UP and dash_scroll > 0:
                dash_scroll -= 1
            elif ch == curses.KEY_DOWN and dash_scroll < max_scroll:
                dash_scroll += 1
            continue

        if view == "audio":
            if ch in (ord("q"), ord("Q")):
                view = "menu"
                audio_status = ""
                continue
            if ch == curses.KEY_UP and audio_menu_sel > 0:
                audio_menu_sel -= 1
            elif ch == curses.KEY_DOWN and audio_menu_sel < len(AUDIO_MENU) - 1:
                audio_menu_sel += 1
            elif ord("1") <= ch <= ord("7"):
                audio_menu_sel = ch - ord("1")
                sub = [
                    "audio_routing",
                    "audio_outputs",
                    "audio_source",
                    "audio_network",
                    "audio_sync",
                    "audio_buffers",
                    "audio_levels",
                ][audio_menu_sel]
                view = sub
                audio_status = ""
                if view == "audio_outputs":
                    load_outputs_from_state()
                elif view == "audio_network":
                    load_net_cfg_from_api()
                elif view == "audio_sync":
                    try:
                        st = pi8_audio_http.get_state()
                        t = st.get("target")
                        d = float(st.get("delay_ms", 0))
                        sync_delay_ms = d
                        if t == "front":
                            sync_sel = 1
                        elif t == "rear":
                            sync_sel = 2
                        else:
                            sync_sel = 0
                    except (pi8_audio_http.Pi8AudioHttpError, OSError, TypeError, ValueError):
                        sync_sel = 0
                        sync_delay_ms = 0.0
                elif view == "audio_buffers":
                    load_buffer_indices()
            elif ch in (10, 13):
                sub = [
                    "audio_routing",
                    "audio_outputs",
                    "audio_source",
                    "audio_network",
                    "audio_sync",
                    "audio_buffers",
                    "audio_levels",
                ][audio_menu_sel]
                view = sub
                audio_status = ""
                if view == "audio_outputs":
                    load_outputs_from_state()
                elif view == "audio_network":
                    load_net_cfg_from_api()
                elif view == "audio_sync":
                    try:
                        st = pi8_audio_http.get_state()
                        t = st.get("target")
                        d = float(st.get("delay_ms", 0))
                        sync_delay_ms = d
                        if t == "front":
                            sync_sel = 1
                        elif t == "rear":
                            sync_sel = 2
                        else:
                            sync_sel = 0
                    except (pi8_audio_http.Pi8AudioHttpError, OSError, TypeError, ValueError):
                        sync_sel = 0
                        sync_delay_ms = 0.0
                elif view == "audio_buffers":
                    load_buffer_indices()
            continue

        if view == "audio_routing":
            if ch in (ord("q"), ord("Q")):
                view = "audio"
                continue
            if ch == ord("1"):
                try:
                    out = pi8_audio_http.post_mode("stereo")
                    audio_status = str(out.get("msg", out))
                except pi8_audio_http.Pi8AudioHttpError as e:
                    audio_status = str(e)
            elif ch == ord("2"):
                try:
                    st = pi8_audio_http.get_state()
                    if st.get("audio_profile") == "simple":
                        if not draw_simple_profile_warning(stdscr):
                            continue
                    out = pi8_audio_http.post_mode("surround")
                    audio_status = str(out.get("msg", out))
                except pi8_audio_http.Pi8AudioHttpError as e:
                    audio_status = str(e)
            continue

        if view == "audio_outputs":
            if ch in (ord("q"), ord("Q")):
                view = "audio"
                continue
            if ch == ord("f"):
                out_fr = not out_fr
            elif ch == ord("h"):
                hdmi_en = not hdmi_en
            elif ch == ord("p"):
                hdmi_port = 1 - hdmi_port if hdmi_port in (0, 1) else 0
            elif ch == ord("r"):
                load_outputs_from_state()
            elif ch == ord("a"):
                try:
                    out = pi8_audio_http.post_hdmi(
                        hdmi_en, port=hdmi_port, outputs_front_rear=out_fr
                    )
                    audio_status = str(out.get("msg", out))
                except pi8_audio_http.Pi8AudioHttpError as e:
                    audio_status = str(e)
            draw_outputs()
            continue

        if view == "audio_source":
            if ch in (ord("q"), ord("Q")):
                view = "audio"
                continue
            src_map = {
                ord("1"): "bluetooth",
                ord("2"): "local",
                ord("3"): "usb",
                ord("4"): "network",
            }
            if ch in src_map:
                try:
                    out = pi8_audio_http.post_source(src_map[ch])
                    audio_status = str(out.get("msg", out))
                except pi8_audio_http.Pi8AudioHttpError as e:
                    audio_status = str(e)
            draw_source()
            continue

        if view == "audio_network":
            if ch in (ord("q"), ord("Q")):
                view = "audio"
                continue
            if ch == ord("r"):
                load_net_cfg_from_api()
            elif ch == ord("g"):
                stdscr.erase()
                my, mx = stdscr.getmaxyx()
                safe_addstr(stdscr, my - 2, 0, _trunc("Multicast group: ", mx))
                v = _read_line_cell(stdscr, my - 2, len("Multicast group: "), mx - 20)
                if v:
                    net_cfg["group"] = v
            elif ch == ord("p"):
                stdscr.erase()
                draw_network()
                vp = read_int_bottom(stdscr, "Port", 1, 65535, net_cfg.get("port", 4010))
                if vp is not None:
                    net_cfg["port"] = vp
            elif ch == ord("i"):
                stdscr.erase()
                my, mx = stdscr.getmaxyx()
                safe_addstr(stdscr, my - 2, 0, _trunc("Interface (empty=all): ", mx))
                v = _read_line_cell(stdscr, my - 2, len("Interface (empty=all): "), mx - 25)
                if v is not None:
                    net_cfg["iface"] = v
            elif ch == ord("u"):
                net_cfg["unicast"] = not bool(net_cfg.get("unicast"))
            elif ch == ord("t"):
                r = int(net_cfg.get("rate", 48000))
                try:
                    i = RATE_OPTIONS.index(r)
                except ValueError:
                    i = 1
                net_cfg["rate"] = RATE_OPTIONS[(i + 1) % len(RATE_OPTIONS)]
            elif ch == ord("f"):
                f = str(net_cfg.get("format", "s16"))
                try:
                    i = FORMAT_OPTIONS.index(f)
                except ValueError:
                    i = 0
                net_cfg["format"] = FORMAT_OPTIONS[(i + 1) % len(FORMAT_OPTIONS)]
            elif ch == ord("s"):
                try:
                    out = pi8_audio_http.post_network_config(
                        group=str(net_cfg["group"]),
                        port=int(net_cfg["port"]),
                        iface=str(net_cfg.get("iface", "")),
                        unicast=bool(net_cfg.get("unicast")),
                        rate=int(net_cfg["rate"]),
                        format=str(net_cfg["format"]),
                    )
                    audio_status = str(out.get("msg", out))
                except pi8_audio_http.Pi8AudioHttpError as e:
                    audio_status = str(e)
            draw_network()
            continue

        if view == "audio_sync":
            if ch in (ord("q"), ord("Q")):
                view = "audio"
                continue
            if ch == ord("n"):
                sync_sel = 0
            elif ch == ord("f"):
                sync_sel = 1
            elif ch == ord("r"):
                sync_sel = 2
            elif ch == ord("+"):
                sync_delay_ms = min(500.0, sync_delay_ms + 5.0)
            elif ch == ord("-") or ch == ord("_"):
                sync_delay_ms = max(0.0, sync_delay_ms - 5.0)
            elif ch == ord("d"):
                stdscr.erase()
                draw_sync()
                vd = read_int_bottom(stdscr, "Delay ms", 0, 500, int(round(sync_delay_ms)))
                if vd is not None:
                    sync_delay_ms = float(vd)
            elif ch == ord("a"):
                try:
                    if sync_delay_ms != 0:
                        st = pi8_audio_http.get_state()
                        if st.get("audio_profile") == "simple":
                            if not draw_simple_profile_warning(stdscr):
                                continue
                    out = pi8_audio_http.post_apply_delay(target_from_sel(), sync_delay_ms)
                    parts = [str(out.get("msg", ""))]
                    if out.get("applying"):
                        parts.append("202 async — polled /apply-status")
                        try:
                            st2 = pi8_audio_http.get_apply_status()
                            parts.append(json.dumps(st2, sort_keys=True))
                        except (pi8_audio_http.Pi8AudioHttpError, OSError):
                            pass
                    audio_status = " | ".join(p for p in parts if p)
                except pi8_audio_http.Pi8AudioHttpError as e:
                    audio_status = str(e)
            draw_sync()
            continue

        if view == "audio_buffers":
            if ch in (ord("q"), ord("Q")):
                view = "audio"
                continue
            if ch == ord("["):
                buf_i_front = (buf_i_front - 1) % len(BUFFER_PRESETS)
            elif ch == ord("]"):
                buf_i_front = (buf_i_front + 1) % len(BUFFER_PRESETS)
            elif ch == ord("{"):
                buf_i_rear = (buf_i_rear - 1) % len(BUFFER_PRESETS)
            elif ch == ord("}"):
                buf_i_rear = (buf_i_rear + 1) % len(BUFFER_PRESETS)
            elif ch == ord("r"):
                load_buffer_indices()
            elif ch == ord("a"):
                try:
                    out = pi8_audio_http.post_buffers(
                        BUFFER_PRESETS[buf_i_front], BUFFER_PRESETS[buf_i_rear]
                    )
                    audio_status = str(out.get("msg", out))
                except pi8_audio_http.Pi8AudioHttpError as e:
                    audio_status = str(e)
            draw_buffers()
            continue

        if view == "audio_levels":
            if ch in (ord("q"), ord("Q")):
                view = "audio"
                continue
            if ch == ord("r"):
                pass
            elif ch == ord("b"):
                stdscr.erase()
                draw_levels()
                vb = read_int_bottom(stdscr, "Balance", -100, 100, None)
                if vb is not None:
                    try:
                        out = pi8_audio_http.post_balance(vb)
                        audio_status = str(out.get("msg", out))
                    except pi8_audio_http.Pi8AudioHttpError as e:
                        audio_status = str(e)
            elif ch == ord("v"):
                stdscr.erase()
                draw_levels()
                vv = read_int_bottom(stdscr, "Volume %", 0, 100, None)
                if vv is not None:
                    try:
                        out = pi8_audio_http.post_volume(vv, mute_toggle=False)
                        audio_status = str(out.get("msg", out))
                    except pi8_audio_http.Pi8AudioHttpError as e:
                        audio_status = str(e)
            elif ch == ord("m"):
                try:
                    out = pi8_audio_http.post_volume(0, mute_toggle=True)
                    audio_status = str(out.get("msg", out))
                except pi8_audio_http.Pi8AudioHttpError as e:
                    audio_status = str(e)
            draw_levels()
            continue

        if view == "display_menu":
            if ch in (ord("q"), ord("Q")):
                view = "menu"
                display_status = ""
                continue
            if ch == curses.KEY_UP and display_menu_sel > 0:
                display_menu_sel -= 1
            elif ch == curses.KEY_DOWN and display_menu_sel < len(DISPLAY_MENU) - 1:
                display_menu_sel += 1
            elif ord("1") <= ch <= ord("3"):
                display_menu_sel = ch - ord("1")
                sub = ["display_quick", "display_sleep", "display_raw"][display_menu_sel]
                view = sub
                display_status = ""
                if view == "display_quick":
                    load_display_draft()
                elif view == "display_sleep":
                    load_sleep_status()
            elif ch in (10, 13):
                sub = ["display_quick", "display_sleep", "display_raw"][display_menu_sel]
                view = sub
                display_status = ""
                if view == "display_quick":
                    load_display_draft()
                elif view == "display_sleep":
                    load_sleep_status()
            continue

        if view == "display_quick":
            if ch in (ord("q"), ord("Q")):
                view = "display_menu"
                continue
            if ch == ord("m"):
                dq_mode_i = (dq_mode_i + 1) % len(DISPLAY_MODES)
            elif ch == ord("o"):
                dq_overlay = not dq_overlay
            elif ch == ord("v"):
                dq_mirror = not dq_mirror
            elif ch == ord("l"):
                dq_lyrics = not dq_lyrics
            elif ch == ord("t"):
                dq_theme_i = (dq_theme_i + 1) % len(VIS_THEMES)
            elif ch == ord("r"):
                load_display_draft()
                display_status = "reloaded from /display-state"
            elif ch == ord("a"):
                try:
                    body = {
                        "mode": DISPLAY_MODES[dq_mode_i],
                        "overlay_enabled": dq_overlay,
                        "visualizer_mirror": dq_mirror,
                        "lyrics_enabled": dq_lyrics,
                        "visualizer_theme": VIS_THEMES[dq_theme_i],
                    }
                    out = pi8_audio_http.post_display(body)
                    display_status = json.dumps(out, sort_keys=True)[:200]
                except pi8_audio_http.Pi8AudioHttpError as e:
                    display_status = str(e)
            continue

        if view == "display_sleep":
            if ch in (ord("q"), ord("Q")):
                view = "display_menu"
                continue
            if ch == ord("r"):
                load_sleep_status()
            elif ch == ord("c"):
                try:
                    pi8_audio_http.delete_sleep_timer()
                    display_status = "cancelled"
                    load_sleep_status()
                except pi8_audio_http.Pi8AudioHttpError as e:
                    display_status = str(e)
            elif ch == ord("s"):
                stdscr.erase()
                draw_display_sleep(stdscr, sleep_active, sleep_remaining_s, display_status)
                my, mx = stdscr.getmaxyx()
                prompt = "Minutes (float): "
                safe_addstr(stdscr, my - 2, 0, _trunc(prompt, mx))
                raw = _read_line_cell(stdscr, my - 2, len(prompt), 20)
                if raw:
                    try:
                        mins = float(raw)
                        if mins > 0:
                            out = pi8_audio_http.post_sleep_timer_minutes(mins)
                            display_status = json.dumps(out, sort_keys=True)[:200]
                            load_sleep_status()
                    except (ValueError, pi8_audio_http.Pi8AudioHttpError) as e:
                        display_status = str(e)
            continue

        if view == "display_raw":
            if ch in (ord("q"), ord("Q")):
                view = "display_menu"
                continue
            if ch == ord("e"):
                path = ""
                try:
                    snap = pi8_audio_http.get_display_state()
                    fd, path = tempfile.mkstemp(suffix=".json", prefix="pi8-display-")
                    os.close(fd)
                    with open(path, "w", encoding="utf-8") as f:
                        json.dump(snap, f, indent=2)
                        f.write("\n")
                    curses.endwin()
                    try:
                        ed = os.environ.get("EDITOR", "nano")
                        subprocess.run(shlex.split(ed) + [path], check=False)
                    finally:
                        stdscr.refresh()
                    with open(path, encoding="utf-8") as f:
                        body = json.load(f)
                    if not isinstance(body, dict):
                        raise ValueError("JSON root must be object")
                    out = pi8_audio_http.post_display(body)
                    display_status = json.dumps(out, sort_keys=True)[:240]
                except (OSError, json.JSONDecodeError, ValueError) as e:
                    display_status = f"error: {e}"
                except pi8_audio_http.Pi8AudioHttpError as e:
                    display_status = str(e)
                finally:
                    if path:
                        try:
                            os.unlink(path)
                        except OSError:
                            pass
            continue

        if view == "presets_menu":
            if ch in (ord("q"), ord("Q")):
                view = "menu"
                presets_status = ""
                continue
            if ch == curses.KEY_UP and presets_menu_sel > 0:
                presets_menu_sel -= 1
            elif ch == curses.KEY_DOWN and presets_menu_sel < len(PRESETS_MENU) - 1:
                presets_menu_sel += 1
            elif ord("1") <= ch <= ord("2"):
                presets_menu_sel = ch - ord("1")
                view = ["presets_scenes", "presets_legacy"][presets_menu_sel]
                presets_status = ""
                if view == "presets_scenes":
                    load_scenes()
                else:
                    load_legacy_names()
            elif ch in (10, 13):
                view = ["presets_scenes", "presets_legacy"][presets_menu_sel]
                presets_status = ""
                if view == "presets_scenes":
                    load_scenes()
                else:
                    load_legacy_names()
            continue

        if view == "presets_scenes":
            if ch in (ord("q"), ord("Q")):
                view = "presets_menu"
                continue
            if ch == ord("r"):
                load_scenes()
            elif ch == ord("e"):
                curses.endwin()
                try:
                    ed = os.environ.get("EDITOR", "nano")
                    subprocess.run(shlex.split(ed) + [SCENE_STORE_PATH], check=False)
                finally:
                    stdscr.refresh()
                load_scenes()
                presets_status = "reloaded scenes list"
            elif scenes_list and ch in (10, 13):
                sc = scenes_list[scene_sel]
                name = str(sc.get("name", "")).strip()
                if name:
                    try:
                        out = pi8_audio_http.post_scene_apply(name)
                        presets_status = json.dumps(out, sort_keys=True)[:200]
                    except pi8_audio_http.Pi8AudioHttpError as e:
                        presets_status = str(e)
            elif ch == curses.KEY_UP and scene_sel > 0:
                scene_sel -= 1
            elif ch == curses.KEY_DOWN and scene_sel < len(scenes_list) - 1:
                scene_sel += 1
            continue

        if view == "presets_legacy":
            if ch in (ord("q"), ord("Q")):
                view = "presets_menu"
                continue
            if ch == ord("r"):
                load_legacy_names()
            elif ch == ord("s"):
                stdscr.erase()
                draw_presets_legacy(stdscr, legacy_names, legacy_sel, presets_status)
                my, mx = stdscr.getmaxyx()
                prompt = "Save preset name: "
                safe_addstr(stdscr, my - 2, 0, _trunc(prompt, mx))
                name = _read_line_cell(stdscr, my - 2, len(prompt), 64).strip()
                if name:
                    try:
                        out = pi8_audio_http.post_presets_save(
                            name, snapshot_from_state=True
                        )
                        presets_status = json.dumps(out, sort_keys=True)[:200]
                        load_legacy_names()
                    except pi8_audio_http.Pi8AudioHttpError as e:
                        presets_status = str(e)
            elif ch == ord("d") and legacy_names:
                stdscr.erase()
                draw_presets_legacy(stdscr, legacy_names, legacy_sel, presets_status)
                my, mx = stdscr.getmaxyx()
                prompt = "Delete preset name: "
                safe_addstr(stdscr, my - 2, 0, _trunc(prompt, mx))
                name = _read_line_cell(stdscr, my - 2, len(prompt), 64).strip()
                if name:
                    try:
                        out = pi8_audio_http.post_presets_delete(name)
                        presets_status = json.dumps(out, sort_keys=True)[:200]
                        load_legacy_names()
                    except pi8_audio_http.Pi8AudioHttpError as e:
                        presets_status = str(e)
            elif legacy_names and ch in (10, 13):
                name = legacy_names[legacy_sel]
                try:
                    out = pi8_audio_http.post_presets_load(name)
                    presets_status = json.dumps(out, sort_keys=True)[:200]
                except pi8_audio_http.Pi8AudioHttpError as e:
                    presets_status = str(e)
            elif ch == curses.KEY_UP and legacy_sel > 0:
                legacy_sel -= 1
            elif ch == curses.KEY_DOWN and legacy_sel < len(legacy_names) - 1:
                legacy_sel += 1
            continue

        if view == "system_menu":
            if ch in (ord("q"), ord("Q")):
                view = "menu"
                system_status = ""
                continue
            if ord("1") <= ch <= ord("8"):
                idx = ch - ord("1")
                if 0 <= idx < len(SYSTEM_MENU_LINES):
                    _k, _lab, svc, scope = SYSTEM_MENU_LINES[idx]
                    try:
                        out = pi8_audio_http.post_restart_service(svc, scope=scope)
                        system_status = json.dumps(out, sort_keys=True)[:200]
                    except pi8_audio_http.Pi8AudioHttpError as e:
                        system_status = str(e)
            elif ch in (ord("p"), ord("P")):
                if draw_confirm(
                    stdscr,
                    "Power STOP — stops PipeWire, BT, receivers (web /power stop)?",
                    "Web UI may stay up.",
                ):
                    try:
                        out = pi8_audio_http.post_power("stop")
                        system_status = json.dumps(out, sort_keys=True)[:200]
                    except pi8_audio_http.Pi8AudioHttpError as e:
                        system_status = str(e)
            elif ch in (ord("s"), ord("S")):
                if draw_confirm(
                    stdscr,
                    "Power START — start audio stack (web /power start)?",
                    "",
                ):
                    try:
                        out = pi8_audio_http.post_power("start")
                        system_status = json.dumps(out, sort_keys=True)[:200]
                    except pi8_audio_http.Pi8AudioHttpError as e:
                        system_status = str(e)
            continue

        if view == "tools_menu":
            if ch in (ord("q"), ord("Q")):
                view = "menu"
                tools_status = ""
                continue
            if ch == curses.KEY_UP and tools_menu_sel > 0:
                tools_menu_sel -= 1
            elif ch == curses.KEY_DOWN and tools_menu_sel < len(TOOLS_MENU) - 1:
                tools_menu_sel += 1
            elif ord("1") <= ch <= ord("2"):
                tools_menu_sel = ch - ord("1")
                view = ["tools_calib", "tools_sync"][tools_menu_sel]
                tools_status = ""
            elif ch in (10, 13):
                view = ["tools_calib", "tools_sync"][tools_menu_sel]
                tools_status = ""
            continue

        if view == "tools_calib":
            if ch in (ord("q"), ord("Q")):
                view = "tools_menu"
                continue
            if ch == ord("s"):
                if draw_confirm(
                    stdscr,
                    "Start calibration noise stream?",
                    "POST /calib-stream action=start",
                ):
                    try:
                        out = pi8_audio_http.post_calib_stream(
                            "start",
                            front_offset_ms=tools_calib_fo,
                            rear_offset_ms=tools_calib_ro,
                            volume=tools_calib_vol,
                        )
                        tools_status = json.dumps(out, sort_keys=True)[:200]
                    except pi8_audio_http.Pi8AudioHttpError as e:
                        tools_status = str(e)
            elif ch == ord("x"):
                try:
                    out = pi8_audio_http.post_calib_stream("stop")
                    tools_status = json.dumps(out, sort_keys=True)[:200]
                except pi8_audio_http.Pi8AudioHttpError as e:
                    tools_status = str(e)
            elif ch == ord("u"):
                try:
                    out = pi8_audio_http.post_calib_stream(
                        "update",
                        front_offset_ms=tools_calib_fo,
                        rear_offset_ms=tools_calib_ro,
                        volume=tools_calib_vol,
                    )
                    tools_status = json.dumps(out, sort_keys=True)[:200]
                except pi8_audio_http.Pi8AudioHttpError as e:
                    tools_status = str(e)
            elif ch == ord("+") or ch == ord("="):
                tools_calib_vol = min(100.0, tools_calib_vol + 2.0)
            elif ch == ord("-") or ch == ord("_"):
                tools_calib_vol = max(0.0, tools_calib_vol - 2.0)
            elif ch == ord("f"):
                tools_calib_fo = min(500.0, tools_calib_fo + 0.5)
            elif ch == ord("r"):
                tools_calib_ro = min(500.0, tools_calib_ro + 0.5)
            continue

        if view == "tools_sync":
            if ch in (ord("q"), ord("Q")):
                view = "tools_menu"
                continue
            if ch == ord("t"):
                if draw_confirm(
                    stdscr,
                    "Run sync test tone (POST /play-sync-test)?",
                    "Uses current front/rear offsets 0/0 from client.",
                ):
                    try:
                        out = pi8_audio_http.post_play_sync_test(0.0, 0.0)
                        tools_status = json.dumps(out, sort_keys=True)[:200]
                    except pi8_audio_http.Pi8AudioHttpError as e:
                        tools_status = str(e)
            continue


def main() -> int:
    try:
        curses.wrapper(run)
    except KeyboardInterrupt:
        return 130
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
