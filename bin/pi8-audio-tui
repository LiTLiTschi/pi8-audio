    stdscr,
    mode: str,
    overlay: bool,
    mirror: bool,
    lyrics: bool,
    theme: str,
    status: str,
) -> None:
    stdscr.erase()
    my, mx = stdscr.getmaxyx()
    safe_addstr(stdscr, 0, 0, "Display — Quick", curses.A_BOLD)
    safe_addstr(stdscr, 2, 0, _trunc(f"mode: {mode}", mx), 0)
    safe_addstr(stdscr, 3, 0, _trunc(f"overlay_enabled: {overlay}", mx), 0)
    safe_addstr(stdscr, 4, 0, _trunc(f"visualizer_mirror: {mirror}", mx), 0)
    safe_addstr(stdscr, 5, 0, _trunc(f"lyrics_enabled: {lyrics}", mx), 0)
    safe_addstr(stdscr, 6, 0, _trunc(f"visualizer_theme: {theme}", mx), 0)
    safe_addstr(
        stdscr,
        8,
        0,
        "m cycle mode  o overlay  v mirror  l lyrics  t theme  a POST /display  r refresh  q back",
        0,
    )
    if status:
        safe_addstr(stdscr, my - 3, 0, _trunc(status, mx), 0)
    safe_addstr(stdscr, my - 1, 0, _trunc("Display quick", mx), curses.A_DIM)


def draw_display_sleep(stdscr, active: bool, remaining_s: int, status: str) -> None:
    stdscr.erase()
    my, mx = stdscr.getmaxyx()
    safe_addstr(stdscr, 0, 0, "Display — Sleep timer", curses.A_BOLD)
    if active:
        m, s = divmod(max(0, remaining_s), 60)
        safe_addstr(stdscr, 2, 0, _trunc(f"Active: {m}m {s:02d}s left", mx), 0)
    else:
        safe_addstr(stdscr, 2, 0, "No sleep timer.", 0)
    safe_addstr(stdscr, 5, 0, "s set minutes (POST)  c cancel (DELETE)  r refresh  q back", 0)
    if status:
        safe_addstr(stdscr, my - 3, 0, _trunc(status, mx), 0)
    safe_addstr(stdscr, my - 1, 0, _trunc("Sleep", mx), curses.A_DIM)


