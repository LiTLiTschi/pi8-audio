# ── Cache busting — ETag per HTML page ────────────────────────────────────────
def _etag(content: str) -> str:
    return '"' + hashlib.md5(content.encode()).hexdigest()[:12] + '"'

_ETAG_MAIN   = _etag(HTML)
_ETAG_REMOTE = _etag(REMOTE_HTML)
_ETAG_DEBUG  = _etag(DEBUG_HTML)
_ETAG_LOG    = _etag(LOG_HTML)
_ETAG_MINIMAL = _etag(MINIMAL_MOBILE_HTML)

# ── HTTP handler ──────────────────────────────────────────────────────────────

_apply_lock = threading.Lock()
_apply_status = {"state": "idle", "error": None}   # "idle" | "applying" | "done" | "error"
_apply_status_lock = threading.Lock()

_sleep_timer: threading.Timer = None
_sleep_timer_end: float = 0.0
_sleep_timer_lock = threading.Lock()

_last_schedule_fire: dict = {}  # preset_name → "YYYY-MM-DD HH:MM" of last fire

_buffers_lock = threading.Lock()
_buffers_cache: dict = {"ts": 0, "data": None}
BUFFERS_CACHE_TTL = 10  # seconds


class Handler(http.server.BaseHTTPRequestHandler):
    def log_message(self, fmt, *args):
        pass  # suppress access log

    def send_json(self, code, data):
        body = json.dumps(data).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", len(body))
        self.end_headers()
        self.wfile.write(body)

    def send_html(self, html: str, etag: str):
        """Serve HTML with ETag-based cache revalidation.
        Returns 304 if browser already has the current version."""
        if self.headers.get("If-None-Match") == etag:
            self.send_response(304)
            self.send_header("ETag", etag)
            self.end_headers()
            return
        body = html.encode()
        self.send_response(200)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", len(body))
        self.send_header("ETag", etag)
        self.send_header("Cache-Control", "no-cache")
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        if self.path == "/state":
            self.send_json(200, load_state())
        elif self.path == "/volume":
            self.send_json(200, get_master_volume())
        elif self.path == "/player-status":
            self.send_json(200, get_player_status())
        elif self.path == "/network-status":
            status = get_scream_status()
            status["config"] = get_network_config()
            try:
                import socket
                s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
                s.connect(("8.8.8.8", 80))
                status["pi_ip"] = s.getsockname()[0]
                s.close()
            except Exception:
                status["pi_ip"] = "?"
            status["hostname"] = os.uname().nodename
            # List network interfaces with IPv4 addresses
            ifaces = []
            try:
                import json as _json
                out = subprocess.check_output(["ip", "-j", "addr", "show"], text=True)
                for iface in _json.loads(out):
                    name = iface.get("ifname", "")
                    addrs = [a["local"] for a in iface.get("addr_info", []) if a.get("family") == "inet"]
                    if addrs and name != "lo":
                        ifaces.append({"name": name, "ip": addrs[0]})
            except Exception:
                pass
            status["interfaces"] = ifaces
            self.send_json(200, status)
        elif self.path == "/presets":
            self.send_json(200, {"ok": True, "presets": get_presets()})
        elif self.path == "/scenes":
            store = pi8_presets.load_store()
            err = pi8_presets.validate_scene_store(store)
            if err:
                self.send_json(500, {"ok": False, "msg": err, "scenes": []})
            else:
                self.send_json(200, {"ok": True, "scenes": pi8_presets.list_scene_summaries(store)})
        elif self.path == "/m":
            self.send_html(MINIMAL_MOBILE_HTML, _ETAG_MINIMAL)
        elif self.path == "/remote":
            self.send_html(REMOTE_HTML, _ETAG_REMOTE)
        elif self.path == "/debug":
            self.send_html(DEBUG_HTML, _ETAG_DEBUG)
        elif self.path == "/display-log-ui":
            self.send_html(LOG_HTML, _ETAG_LOG)
        elif self.path == "/apply-status":
            with _apply_status_lock:
                self.send_json(200, dict(_apply_status))
        elif self.path == "/display-state":
            try:
                with urllib.request.urlopen("http://localhost:8084/state", timeout=2) as r:
                    self.send_json(200, json.loads(r.read()))
            except Exception:
                self.send_json(200, {"mode": "off", "overlay_enabled": True,
                                     "visualizer_mirror": False,
                                     "status": "daemon_down", "track": None})
        elif self.path == "/display-history":
            try:
                with urllib.request.urlopen("http://localhost:8084/history", timeout=2) as r:
                    self.send_json(200, json.loads(r.read()))
            except Exception:
                self.send_json(200, [])
        elif self.path == "/sleep-timer":
            with _sleep_timer_lock:
                remaining = max(0.0, _sleep_timer_end - time.time()) if _sleep_timer else 0.0
            self.send_json(200, {"active": _sleep_timer is not None, "remaining_seconds": int(remaining)})
        elif self.path == "/display-frame":
            try:
                with urllib.request.urlopen("http://localhost:8084/frame", timeout=2) as r:
                    data = r.read()
                self.send_response(200)
                self.send_header("Content-Type", "image/png")
                self.send_header("Content-Length", len(data))
                self.send_header("Cache-Control", "no-cache")
                self.end_headers()
                self.wfile.write(data)
            except Exception:
                self.send_response(503); self.end_headers()
        elif self.path == "/display-log":
            try:
                with urllib.request.urlopen("http://localhost:8084/log", timeout=2) as r:
                    data = r.read()
                self.send_response(200)
                self.send_header("Content-Type", "text/plain; charset=utf-8")
                self.send_header("Content-Length", len(data))
                self.send_header("Cache-Control", "no-store, max-age=0")
                self.send_header("Pragma", "no-cache")
                self.end_headers()
                self.wfile.write(data)
            except Exception:
                self.send_response(503); self.end_headers()
        elif self.path.startswith("/log/"):
            parsed = urllib.parse.urlparse(self.path)
            key = parsed.path[len("/log/"):]
            qs = urllib.parse.parse_qs(parsed.query or "")
            try:
                lines = int(qs.get("n", ["300"])[0])
            except Exception:
                lines = 300
            lines = max(50, min(2000, lines))
            text = get_service_log(key, lines=lines)
            if not text:
                msg = f"unknown log key: {key}. valid: {', '.join(sorted(LOG_ENDPOINTS.keys()))}\n"
                data = msg.encode()
                self.send_response(404)
                self.send_header("Content-Type", "text/plain; charset=utf-8")
                self.send_header("Content-Length", len(data))
                self.send_header("Cache-Control", "no-store, max-age=0")
                self.send_header("Pragma", "no-cache")
                self.end_headers()
                self.wfile.write(data)
            else:
                data = text.encode()
                self.send_response(200)
                self.send_header("Content-Type", "text/plain; charset=utf-8")
                self.send_header("Content-Length", len(data))
                self.send_header("Cache-Control", "no-store, max-age=0")
                self.send_header("Pragma", "no-cache")
                self.end_headers()
                self.wfile.write(data)
        else:
            self.send_html(HTML, _ETAG_MAIN)

    def do_POST(self):
        if self.path == "/simulate":
            length = int(self.headers.get("Content-Length", 0))
            body = self.rfile.read(length)
            try:
                req = urllib.request.Request("http://localhost:8084/simulate",
                      data=body, headers={"Content-Type": "application/json"})
                with urllib.request.urlopen(req, timeout=2) as r:
                    self.send_json(r.getcode(), json.loads(r.read()))
            except Exception as e:
                self.send_json(502, {"ok": False, "msg": str(e)})
            return
        if self.path not in ("/apply", "/balance", "/mode", "/volume", "/player", "/debug-volume", "/debug-test", "/source", "/network-config", "/buffers", "/restart-service", "/play-sync-test", "/calib-stream", "/presets", "/presets/load", "/presets/delete", "/presets/schedule", "/hdmi", "/power", "/display", "/sleep-timer", "/display-mode", "/scene/apply", "/audio-profile"):
            self.send_json(404, {"ok": False, "msg": "not found"})
            return

        length = int(self.headers.get("Content-Length", 0))
        body   = self.rfile.read(length)
        try:
            data = json.loads(body)
        except json.JSONDecodeError:
            self.send_json(400, {"ok": False, "msg": "bad JSON"})
            return

        if self.path == "/display-mode":
            mode = data.get("mode", "")
            if mode not in pi8_presets.ALLOWED_DISPLAY_MODES:
                self.send_json(400, {"ok": False, "msg": "invalid display mode"})
                return
            try:
                req = urllib.request.Request(
                    "http://localhost:8084/set",
                    data=json.dumps({"mode": mode}).encode(),
                    headers={"Content-Type": "application/json"},
                )
                with urllib.request.urlopen(req, timeout=20) as r:
                    self.send_json(r.getcode(), json.loads(r.read().decode()))
            except Exception as e:
                self.send_json(502, {"ok": False, "msg": str(e)})
            return

        if self.path == "/scene/apply":
            name = str(data.get("name", "")).strip()
            if not name:
                self.send_json(400, {"ok": False, "msg": "name required"})
                return
            store = pi8_presets.load_store()
            err = pi8_presets.validate_scene_store(store)
            if err:
                self.send_json(500, {"ok": False, "msg": err})
                return
            scene = pi8_presets.get_scene(name, store)
            if not scene:
                self.send_json(404, {"ok": False, "msg": "scene not found"})
                return
            try:
                state = load_state()
                state = pi8_presets.merge_audio_into_state(scene, state)
                save_state(state)
                apply_buffers(state.get("buffer_front", 2048), state.get("buffer_rear", 512))
                with _apply_lock:
                    apply_state(state)
                dpayload = pi8_presets.display_payload(scene)
                req = urllib.request.Request(
                    "http://localhost:8084/set",
                    data=json.dumps(dpayload).encode(),
                    headers={"Content-Type": "application/json"},
                )
                with urllib.request.urlopen(req, timeout=20) as r:
                    disp_resp = json.loads(r.read().decode())
                self.send_json(200, {"ok": True, "display": disp_resp})
            except Exception as e:
                log.exception("scene apply")
                self.send_json(500, {"ok": False, "msg": str(e)})
            return

        if self.path == "/audio-profile":
            prof = str(data.get("profile", "")).strip().lower()
            if prof not in ("simple", "multi"):
                self.send_json(400, {"ok": False, "msg": "profile must be simple or multi"})
                return
            try:
                with _apply_lock:
                    state = load_state()
                    state["audio_profile"] = prof
                    save_state(state)
                    apply_state(state)
                self.send_json(200, {"ok": True, "msg": f"audio_profile={prof}"})
            except subprocess.CalledProcessError as e:
                self.send_json(500, {"ok": False, "msg": str(e)})
            return

        if self.path == "/balance":
            balance = int(data.get("balance", 0))
            if balance < -100 or balance > 100:
                self.send_json(400, {"ok": False, "msg": "balance out of range (-100…+100)"})
                return
            with _apply_lock:
                state = load_state()
                state["balance"] = balance
                save_state(state)
                try:
                    apply_balance(balance)
                except subprocess.CalledProcessError as e:
                    self.send_json(500, {"ok": False, "msg": str(e)})
                    return
            if balance == 0:
                msg = "Balance: Gleich (beide 100%)"
            elif balance < 0:
                msg = f"Front 100% / Rear {100 + balance}%"
            else:
                msg = f"Front {100 - balance}% / Rear 100%"
            self.send_json(200, {"ok": True, "msg": msg})
            return

        if self.path == "/mode":
            mode = data.get("mode", "stereo")
            if mode not in ("stereo", "surround"):
                self.send_json(400, {"ok": False, "msg": "invalid mode (stereo|surround)"})
                return
            with _apply_lock:
                state = load_state()
                state["mode"] = mode
                save_state(state)
                try:
                    apply_state(state)
                except subprocess.CalledProcessError as e:
                    self.send_json(500, {"ok": False, "msg": str(e)})
                    return
            label = "Surround 4.0 (FL/FR → Front, RL/RR → Rear)" if mode == "surround" else "Stereo (beide Outputs gleich)"
            self.send_json(200, {"ok": True, "msg": f"Modus: {label}"})
            return

        if self.path == "/source":
            source = data.get("source", "bluetooth")
            if source not in ("bluetooth", "local", "usb", "network"):
                self.send_json(400, {"ok": False, "msg": "invalid source (bluetooth|local|usb|network)"})
                return
            with _apply_lock:
                state = load_state()
                state["source"] = source
                save_state(state)
                try:
                    set_source(source)
                except Exception as e:
                    self.send_json(500, {"ok": False, "msg": str(e)})
                    return
            labels = {
                "bluetooth": "Bluetooth (A2DP)",
                "local": "Lokale Wiedergabe",
                "usb": "USB Line-In (UFO202 → Speakers)",
                "network": "Netzwerk (Scream empfängt von Windows)"
            }
            self.send_json(200, {"ok": True, "msg": f"Quelle: {labels.get(source, source)}"})
            return

        if self.path == "/network-config":
            nc = {
                "group": str(data.get("group", "239.255.77.77")).strip(),
                "port": int(data.get("port", 4010)),
                "iface": str(data.get("iface", "")).strip(),
                "unicast": bool(data.get("unicast", False)),
                "rate": int(data.get("rate", 48000)),
                "format": str(data.get("format", "s16")).strip(),
            }
            if nc["port"] < 1 or nc["port"] > 65535:
                self.send_json(400, {"ok": False, "msg": "Port muss zwischen 1 und 65535 liegen"})
                return
            if nc["rate"] not in (44100, 48000, 96000, 192000):
                self.send_json(400, {"ok": False, "msg": "Ungültige Sample Rate"})
                return
            if nc["format"] not in ("s16", "s32", "f32"):
                self.send_json(400, {"ok": False, "msg": "Ungültiges Format"})
                return
            with _apply_lock:
                state = load_state()
                state["network_config"] = nc
                save_state(state)
                # Restart receiver if network source is active
                if state.get("source") == "network":
                    try:
                        start_scream_receiver(nc)
                    except Exception as e:
                        self.send_json(500, {"ok": False, "msg": str(e)})
                        return
            restart_msg = " Receiver neu gestartet." if state.get("source") == "network" else ""
            self.send_json(200, {"ok": True, "msg": f"Netzwerk-Konfiguration gespeichert.{restart_msg}", "config": nc})
            return

        if self.path == "/buffers":
            now = time.time()
            if _buffers_cache["data"] and now - _buffers_cache["ts"] < BUFFERS_CACHE_TTL:
                self.send_json(200, _buffers_cache["data"])
                return
            if not _buffers_lock.acquire(blocking=False):
                # scan in progress, return stale cache or empty
                self.send_json(200, _buffers_cache["data"] or {})
                return
            try:
                front_buf = int(data.get("front", 2048))
                rear_buf  = int(data.get("rear", 512))
                with _apply_lock:
                    state = load_state()
                    state["buffer_front"] = front_buf
                    state["buffer_rear"]  = rear_buf
                    save_state(state)
                    apply_buffers(front_buf, rear_buf)
                    subprocess.run(["systemctl", "--user", "restart", "pipewire", "pipewire-pulse", "wireplumber"], check=False)
                    time.sleep(3)
                    apply_state(state)
                result = {"ok": True, "msg": f"Buffer: Front={front_buf}, Rear={rear_buf}. PipeWire neu gestartet."}
                _buffers_cache["data"] = result
                _buffers_cache["ts"] = time.time()
                self.send_json(200, result)
            finally:
                _buffers_lock.release()
            return

        if self.path == "/restart-service":
            svc   = data.get("service", "")
            scope = data.get("scope", "user")
            ALLOWED_USER   = {"pipewire", "pipewire-pulse", "wireplumber", "audio-sync-web", "dlna-renderer", "cast-receiver", "display-daemon", "mpris-proxy"}
            ALLOWED_SYSTEM = {"bluetooth"}
            ALL_SERVICES   = [
                ("user",   "pipewire pipewire-pulse wireplumber"),
                ("user",   "dlna-renderer"),
                ("system", "bluetooth"),
                ("user",   "audio-sync-web"),
            ]
            try:
                if svc == "ALL":
                    # Restart everything except audio-sync-web first, then send response,
                    # then restart audio-sync-web in background so the connection isn't dropped.
                    for sc, svcs in ALL_SERVICES:
                        if "audio-sync-web" in svcs:
                            continue
                        if sc == "user":
                            subprocess.run(["systemctl", "--user", "restart"] + svcs.split(), check=False)
                        elif svcs.strip() == "bluetooth":
                            restart_system_bluetooth_stack()
                        else:
                            subprocess.run(["sudo", "systemctl", "restart"] + svcs.split(), check=False)
                        time.sleep(1)
                    self.send_json(200, {"ok": True, "msg": "Alle Services neu gestartet. Web UI startet gleich neu…"})
                    def _restart_self():
                        time.sleep(1)
                        subprocess.run(["systemctl", "--user", "restart", "audio-sync-web"], check=False)
                    threading.Thread(target=_restart_self, daemon=True).start()
                elif svc == "DISPLAY_RESTART":
                    # Ordered: mpris-proxy → display-daemon
                    subprocess.run(["systemctl", "--user", "restart", "mpris-proxy"], check=False)
                    time.sleep(1)
                    subprocess.run(["systemctl", "--user", "restart", "display-daemon"], check=False)
                    self.send_json(200, {"ok": True, "msg": "mpris-proxy + display-daemon neu gestartet."})
                else:
                    parts = svc.split()
                    if scope == "system":
                        allowed = ALLOWED_SYSTEM
                    else:
                        allowed = ALLOWED_USER
                    if not all(p in allowed for p in parts):
                        self.send_json(400, {"ok": False, "msg": f"Service nicht erlaubt: {svc}"})
                        return
                    if scope == "user":
                        subprocess.run(["systemctl", "--user", "restart"] + parts, check=False)
                    elif parts == ["bluetooth"]:
                        restart_system_bluetooth_stack()
                    else:
                        subprocess.run(["sudo", "systemctl", "restart"] + parts, check=False)
                    self.send_json(200, {"ok": True, "msg": f"{svc} neu gestartet."})
            except Exception as e:
                self.send_json(500, {"ok": False, "msg": str(e)})
            return

        if self.path == "/play-sync-test":
            try:
                fo = float(data.get("front_offset_ms", 0))
                ro = float(data.get("rear_offset_ms",  0))
                threading.Thread(target=play_sync_test, args=(fo, ro), daemon=True).start()
                self.send_json(200, {"ok": True})
            except Exception as e:
                self.send_json(500, {"ok": False, "msg": str(e)})
            return

        if self.path == "/calib-stream":
            action = data.get("action", "update")  # start | stop | update
            fo  = float(data.get("front_offset_ms", 0))
            ro  = float(data.get("rear_offset_ms",  0))
            vol = float(data.get("volume", 70))
            try:
                if action == "start":
                    threading.Thread(target=start_calib_stream, args=(fo, ro, vol), daemon=True).start()
                elif action == "stop":
                    stop_calib_stream()
                else:  # update
                    update_calib_offset(fo, ro, vol)
                self.send_json(200, {"ok": True, "streaming": not _calib_stop.is_set()})
            except Exception as e:
                self.send_json(500, {"ok": False, "msg": str(e)})
            return

        if self.path == "/presets":
            name = data.get("name", "").strip()
            if not name:
                self.send_json(400, {"ok": False, "msg": "Name fehlt"})
                return
            save_preset(name, load_state())
            self.send_json(200, {"ok": True, "msg": f"Preset '{name}' gespeichert.", "presets": get_presets()})
            return

        if self.path == "/presets/load":
            name = data.get("name", "")
            ok, msg = load_preset(name)
            self.send_json(200 if ok else 404, {"ok": ok, "msg": msg})
            return

        if self.path == "/presets/delete":
            name = data.get("name", "")
            delete_preset(name)
            self.send_json(200, {"ok": True, "msg": f"Preset '{name}' gelöscht.", "presets": get_presets()})
            return

        if self.path == "/presets/schedule":
            name     = data.get("name", "").strip()
            schedule = data.get("schedule")  # dict or None/falsy to clear
            if not name:
                self.send_json(400, {"ok": False, "msg": "Name fehlt"})
                return
            ok = save_preset_schedule(name, schedule)
            if ok:
                self.send_json(200, {"ok": True, "presets": get_presets()})
            else:
                self.send_json(404, {"ok": False, "msg": "Preset nicht gefunden"})
            return

        if self.path == "/hdmi":
            enabled    = bool(data.get("enabled", False))
            port       = int(data.get("port", 0))
            front_rear = data.get("outputs_front_rear", None)
            if port not in (0, 1):
                self.send_json(400, {"ok": False, "msg": "invalid port (0|1)"})
                return
            with _apply_lock:
                state = load_state()
                state["hdmi_enabled"] = enabled
                state["hdmi_port"]    = port
                if front_rear is not None:
                    state["outputs_front_rear"] = bool(front_rear)
                # Safety: ensure at least one output is active
                if not state.get("outputs_front_rear", True) and not enabled:
                    state["outputs_front_rear"] = True
                save_state(state)
                try:
                    apply_state(state)
                except subprocess.CalledProcessError as e:
                    self.send_json(500, {"ok": False, "msg": str(e)})
                    return
            parts = []
            if state.get("outputs_front_rear", True):
                parts.append("Front+Rear")
            if enabled:
                h0, h1 = detect_hdmi_sinks()
                parts.append(f"HDMI {port} ({h0 if port == 0 else h1})")
            self.send_json(200, {"ok": True, "msg": f"Outputs: {', '.join(parts)}. PipeWire neu gestartet."})
            return

        if self.path == "/power":
            action = data.get("action", "")
            if action not in ("stop", "start"):
                self.send_json(400, {"ok": False, "msg": "invalid action (stop|start)"})
                return
            POWER_USER   = ["pipewire", "pipewire-pulse", "wireplumber", "dlna-renderer"]
            POWER_SYSTEM = ["bluetooth"]
            try:
                if action == "stop":
                    stop_usb_loopback()
                    stop_scream_receiver()
                    stop_calib_stream()
                    subprocess.run(["systemctl", "--user", "stop", "bt-speaker"], check=False)
                    subprocess.run(["systemctl", "--user", "stop"] + POWER_USER, check=False)
                    subprocess.run(["sudo", "systemctl", "stop"] + POWER_SYSTEM, check=False)
                    self.send_json(200, {"ok": True, "msg": "System gestoppt. Web UI läuft weiter."})
                else:
                    subprocess.run(["systemctl", "--user", "start"] + POWER_USER, check=False)
                    subprocess.run(["sudo", "systemctl", "start"] + POWER_SYSTEM, check=False)
                    time.sleep(1.5)
                    subprocess.run(["systemctl", "--user", "restart", "bt-speaker"], check=False)
                    time.sleep(3)
                    state = load_state()
                    try:
                        with _apply_lock:
                            apply_state(state)
                    except Exception:
                        pass
                    src = state.get("source", "bluetooth")
                    if src in ("usb", "network"):
                        try:
                            set_source(src)
                        except Exception:
                            pass
                    self.send_json(200, {"ok": True, "msg": "System gestartet und State wiederhergestellt."})
            except Exception as e:
                self.send_json(500, {"ok": False, "msg": str(e)})
            return

        if self.path == "/display":
            try:
                req = urllib.request.Request(
                    "http://localhost:8084/set", data=body,
                    headers={"Content-Type": "application/json"})
                with urllib.request.urlopen(req, timeout=2) as r:
                    self.send_json(r.getcode(), json.loads(r.read()))
            except Exception as e:
                self.send_json(502, {"ok": False, "msg": str(e)})
            return

        if self.path == "/volume":
            if data.get("mute_toggle"):
                try:
                    toggle_mute()
                except subprocess.CalledProcessError as e:
                    self.send_json(500, {"ok": False, "error": str(e)})
                    return
                self.send_json(200, {**get_master_volume(), "ok": True})
                return
            vol = int(data.get("volume", 50))
            vol = max(0, min(100, vol))
            try:
                set_master_volume(vol)
            except subprocess.CalledProcessError as e:
                self.send_json(500, {"ok": False, "error": str(e)})
                return
            self.send_json(200, {"ok": True, "volume": vol})
            return

        if self.path == "/player":
            action = data.get("action", "")
            if action == "seek":
                pos = float(data.get("position", 0))
                subprocess.run(["playerctl", "position", str(pos)], stderr=subprocess.DEVNULL)
                self.send_json(200, {"ok": True, "msg": "seeked"})
                return
            if action not in ("play-pause", "next", "previous", "play", "pause"):
                self.send_json(400, {"ok": False, "msg": "invalid action"})
                return
            try:
                player_cmd(action)
                self.send_json(200, {"ok": True, "msg": action})
            except subprocess.CalledProcessError:
                self.send_json(200, {"ok": True, "msg": "no player"})
            return

        if self.path == "/sleep-timer":
            minutes = float(data.get("minutes", 30))
            seconds = minutes * 60
            with _sleep_timer_lock:
                global _sleep_timer, _sleep_timer_end
                if _sleep_timer:
                    _sleep_timer.cancel()
                _sleep_timer = threading.Timer(seconds, _sleep_timer_fire)
                _sleep_timer.daemon = True
                _sleep_timer.start()
                _sleep_timer_end = time.time() + seconds
            self.send_json(200, {"ok": True, "minutes": minutes})
            return

        if self.path == "/debug-volume":
            fl = max(0, min(100, int(data.get("fl", 100))))
            fr = max(0, min(100, int(data.get("fr", 100))))
            rl = max(0, min(100, int(data.get("rl", 100))))
            rr = max(0, min(100, int(data.get("rr", 100))))
            try:
                set_speaker_volumes(fl, fr, rl, rr)
                self.send_json(200, {"ok": True, "fl": fl, "fr": fr, "rl": rl, "rr": rr})
            except subprocess.CalledProcessError as e:
                self.send_json(500, {"ok": False, "msg": str(e)})
            return

        if self.path == "/debug-test":
            ch = data.get("channel", "all")
            # speaker-test channel numbers: 1=FL, 2=FR, 3=RL, 4=RR
            ch_map = {"fl": "1", "fr": "2", "rl": "3", "rr": "4"}
            try:
                if ch == "all":
                    subprocess.run(
                        ["speaker-test", "-D", "pulse", "-c", "4", "-t", "sine", "-l", "1", "-p", "500"],
                        timeout=10, check=True, capture_output=True
                    )
                elif ch in ch_map:
                    subprocess.run(
                        ["speaker-test", "-D", "pulse", "-c", "4", "-t", "sine", "-s", ch_map[ch], "-l", "1"],
                        timeout=5, check=True, capture_output=True
                    )
                else:
                    self.send_json(400, {"ok": False, "msg": "invalid channel"})
                    return
                self.send_json(200, {"ok": True, "msg": f"Test {ch} done"})
            except (subprocess.CalledProcessError, subprocess.TimeoutExpired) as e:
                self.send_json(200, {"ok": True, "msg": f"Test {ch} finished"})
            return

        if self.path == "/apply":
            target   = data.get("target")   # "front" | "rear" | None
            delay_ms = float(data.get("delay_ms", 0))

            if target not in (None, "front", "rear"):
                self.send_json(400, {"ok": False, "msg": "invalid target"})
                return
            if delay_ms < 0 or delay_ms > 500:
                self.send_json(400, {"ok": False, "msg": "delay out of range (0–500ms)"})
                return

            with _apply_status_lock:
                if _apply_status["state"] == "applying":
                    self.send_json(409, {"ok": False, "error": "already applying"})
                    return
                _apply_status["state"] = "applying"
                _apply_status["error"] = None

            def _do_apply():
                try:
                    with _apply_lock:
                        state = load_state()
                        state["target"]   = data.get("target")
                        state["delay_ms"] = float(data.get("delay_ms", 0))
                        save_state(state)
                        apply_state(state)
                    with _apply_status_lock:
                        _apply_status["state"] = "done"
                except Exception as e:
                    print(f"apply_state failed: {e}")
                    with _apply_status_lock:
                        _apply_status["state"] = "error"
                        _apply_status["error"] = str(e)

            threading.Thread(target=_do_apply, daemon=True).start()
            self.send_json(202, {"ok": True, "applying": True})
            return

    def do_DELETE(self):
        if self.path == "/sleep-timer":
            with _sleep_timer_lock:
                global _sleep_timer, _sleep_timer_end
                if _sleep_timer:
                    _sleep_timer.cancel()
                    _sleep_timer = None
                    _sleep_timer_end = 0.0
            self.send_json(200, {"ok": True})
        else:
            self.send_json(404, {"error": "not found"})


# ── main ──────────────────────────────────────────────────────────────────────

if __name__ == "__main__":
    # Restore source on startup (e.g. after service restart)
    try:
        state = load_state()
        # Ensure ALSA buffer lua rules match saved config
        front_buf = state.get("buffer_front", 2048)
        rear_buf  = state.get("buffer_rear", 512)
        apply_buffers(front_buf, rear_buf)
        src = state.get("source", "bluetooth")
        if src in ("usb", "network"):
            set_source(src)
    except Exception:
        pass
    threading.Thread(target=_preset_scheduler, daemon=True).start()
    port = 8083
    server = http.server.ThreadingHTTPServer(("0.0.0.0", port), Handler)
    print(f"Audio Sync UI → http://pi8:{port}  (Ctrl+C zum Beenden)")
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print("\nStopped.")
