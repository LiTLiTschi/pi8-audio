<script>
let auto = true;
let timer = null;

async function loadLog() {
  const st = document.getElementById('status');
  try {
    const res = await fetch('/display-log', {cache: 'no-store'});
    if (!res.ok) throw new Error('HTTP ' + res.status);
    const text = await res.text();
    const pre = document.getElementById('log');
    pre.textContent = text || '(empty)';
    st.textContent = 'Updated: ' + new Date().toLocaleTimeString();
  } catch (e) {
    document.getElementById('log').textContent = 'unavailable';
    st.textContent = 'Error: ' + e.message;
  }
}

function startAuto() {
  stopAuto();
  const ms = parseInt(document.getElementById('interval').value, 10) || 3000;
  timer = setInterval(loadLog, ms);
}

function stopAuto() {
  if (timer) clearInterval(timer);
  timer = null;
}

document.getElementById('refresh-btn').addEventListener('click', loadLog);
document.getElementById('auto-btn').addEventListener('click', () => {
  auto = !auto;
  document.getElementById('auto-btn').textContent = 'Auto: ' + (auto ? 'On' : 'Off');
  if (auto) startAuto(); else stopAuto();
});
document.getElementById('interval').addEventListener('change', () => {
  if (auto) startAuto();
});
document.getElementById('bottom-btn').addEventListener('click', () => {
  const pre = document.getElementById('log');
  pre.scrollTop = pre.scrollHeight;
});

loadLog();
startAuto();
</script>
</body>
</html>
