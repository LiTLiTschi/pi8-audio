#!/usr/bin/env python3
"""
audio-sync-web — Web UI to fine-tune delay between BCM2835 (3.5mm) and CM108 (USB).
Runs on http://pi8:8083
"""

import hashlib
import http.server
import json
import logging
import logging.handlers
import os
import signal
import subprocess
import sys
import threading
import time
import urllib.parse
import urllib.request
from pathlib import Path

_SCRIPT_DIR = str(Path(__file__).resolve().parent)
if _SCRIPT_DIR not in sys.path:
    sys.path.insert(0, _SCRIPT_DIR)
import pi8_presets  # noqa: E402

_LOG_FILE = "/tmp/pi8-audio.log"
logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s [%(levelname)s] %(name)s %(message)s",
    datefmt="%Y-%m-%d %H:%M:%S",
    handlers=[
        logging.StreamHandler(),
        logging.handlers.RotatingFileHandler(
            _LOG_FILE, maxBytes=2*1024*1024, backupCount=1, encoding="utf-8"
        ),
    ],
)
log = logging.getLogger("audio-sync-web")

STATE_FILE    = os.path.expanduser("~/.config/audio-sync.json")
DELAY_CONF    = os.path.expanduser("~/.config/pipewire/pipewire.conf.d/audio-sync-delay.conf")
COMBINED_CONF = os.path.expanduser("~/.config/pipewire/pipewire.conf.d/combined.conf")

FRONT_ALSA = "alsa_output.platform-bcm2835_audio.stereo-fallback"
REAR_ALSA  = "alsa_output.usb-C-Media_Electronics_Inc._USB_PnP_Sound_Device-00.analog-stereo"
DELAY_NODE = "audio-sync-delay-sink"

UFO202_SOURCE = "alsa_input.usb-Burr-Brown_from_TI_USB_Audio_CODEC-00.analog-stereo-input"
UFO202_SINK   = "alsa_output.usb-Burr-Brown_from_TI_USB_Audio_CODEC-00.analog-stereo-output"

# HDMI outputs (Raspberry Pi 4 has two HDMI ports)
HDMI0_ALSA = "alsa_output.platform-fef00700.hdmi.hdmi-stereo"
HDMI1_ALSA = "alsa_output.platform-fef05700.hdmi.hdmi-stereo"

def detect_hdmi_sinks():
    """Try to detect actual PipeWire HDMI sink names. Returns (hdmi0, hdmi1)."""
    try:
        out = subprocess.run(
            ["pactl", "list", "sinks", "short"],
            capture_output=True, text=True, timeout=3
        ).stdout
        sinks = [line.split()[1] for line in out.splitlines() if len(line.split()) >= 2]
        hdmi0 = next((s for s in sinks if "fef00700" in s or "vc4hdmi0" in s or ("hdmi" in s.lower() and "0" in s)), HDMI0_ALSA)
        hdmi1 = next((s for s in sinks if "fef05700" in s or "vc4hdmi1" in s or ("hdmi" in s.lower() and "1" in s)), HDMI1_ALSA)
        return hdmi0, hdmi1
    except Exception:
        return HDMI0_ALSA, HDMI1_ALSA


def hdmi_sink_for_state(state):
    port = int(state.get("hdmi_port", 0))
    h0, h1 = detect_hdmi_sinks()
    return h0 if port == 0 else h1


def playback_loopback_target(state):
    """PipeWire node name for pw-loopback / network sink playback."""
    if state.get("audio_profile", "multi") == "simple":
        return hdmi_sink_for_state(state)
    return "combined"


def set_default_sink_pulse(sink_name):
    subprocess.run(["pactl", "set-default-sink", sink_name], check=False)


def clear_combined_conf():
    """Disable combine-stream (simple profile)."""
    os.makedirs(os.path.dirname(COMBINED_CONF), exist_ok=True)
    with open(COMBINED_CONF, "w") as f:
        f.write(
            "# Generated by audio-sync-web — simple profile (no combine-stream)\n"
            "context.modules = []\n"
        )


# ── Volume helpers ────────────────────────────────────────────────────────────

def set_sink_volume(sink_name, percent):
    """Set volume of a PipeWire/PulseAudio sink (0–100%)."""
    subprocess.run(
        ["pactl", "set-sink-volume", sink_name, f"{int(percent)}%"],
        check=True,
    )


def apply_balance(balance):
    """Apply front/rear balance. balance: -100 (front only) … 0 (equal) … +100 (rear only)."""
    balance = max(-100, min(100, balance))
    if balance <= 0:
        front_pct = 100
        rear_pct  = 100 + balance   # 0 at -100, 100 at 0
    else:
        front_pct = 100 - balance   # 100 at 0, 0 at +100
        rear_pct  = 100
    set_sink_volume(FRONT_ALSA, front_pct)
    set_sink_volume(REAR_ALSA,  rear_pct)


def get_master_volume():
    """Get default sink volume as 0–100 int (combined or HDMI in simple profile)."""
    try:
        out = subprocess.run(
            ["wpctl", "get-volume", "@DEFAULT_AUDIO_SINK@"],
            capture_output=True, text=True, check=True
        ).stdout.strip()  # "Volume: 0.80" or "Volume: 0.80 [MUTED]"
        parts = out.split()
        vol = float(parts[1])
        muted = "[MUTED]" in out
        return {"volume": int(round(vol * 100)), "muted": muted}
    except Exception:
        return {"volume": 50, "muted": False}


def set_master_volume(percent):
    """Set default sink volume (0–100)."""
    subprocess.run(
        ["wpctl", "set-volume", "@DEFAULT_AUDIO_SINK@", f"{int(percent)}%"],
        check=True
    )


def toggle_mute():
    subprocess.run(["wpctl", "set-mute", "@DEFAULT_AUDIO_SINK@", "toggle"], check=True)


def restart_system_bluetooth_stack():
    """Restart bluetoothd, wait out the Busy window, then re-run bt-speaker (discoverable + agent)."""
    log.info("restarting system bluetooth + bt-speaker")
    subprocess.run(["sudo", "systemctl", "restart", "bluetooth"], check=False)
    time.sleep(1.5)
    subprocess.run(["systemctl", "--user", "restart", "bt-speaker"], check=False)


