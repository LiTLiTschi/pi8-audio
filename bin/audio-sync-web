        "title": "DLNA Renderer",
        "scope": "user",
        "units": ["dlna-renderer"],
    },
    "display": {
        "title": "Display Stack",
        "scope": "user",
        "units": ["display-daemon", "mpris-proxy"],
    },
}


def get_service_log(key: str, lines: int = 300) -> str:
    cfg = LOG_ENDPOINTS.get(key)
    if not cfg:
        return ""
    args = ["journalctl", "-n", str(lines), "--no-pager", "-o", "short-iso"]
    if cfg.get("scope") == "user":
        args.append("--user")
    for unit in cfg.get("units", []):
        args += ["-u", unit]
    try:
        return subprocess.check_output(args, text=True, stderr=subprocess.STDOUT)
    except subprocess.CalledProcessError as e:
        return e.stdout or str(e)


# ── MPRIS / playerctl helpers ─────────────────────────────────────────────────

def player_cmd(action):
    """Run playerctl action: play-pause, next, previous, play, pause."""
    subprocess.run(["playerctl", action], check=True)


def get_player_status():
    """Get current player metadata and status."""
    info = {"status": "Stopped", "title": "", "artist": "", "album": "", "artUrl": ""}
    try:
        info["status"] = subprocess.run(
            ["playerctl", "status"], capture_output=True, text=True, check=True
        ).stdout.strip()
    except subprocess.CalledProcessError:
        return info
    for field in ["title", "artist", "album", "artUrl"]:
        try:
            key = f"xesam:{field}" if field != "artUrl" else "mpris:artUrl"
            val = subprocess.run(
                ["playerctl", "metadata", key],
                capture_output=True, text=True, check=True
            ).stdout.strip()
            info[field] = val
        except subprocess.CalledProcessError:
            pass
    try:
        pos_out = subprocess.run(["playerctl", "position"], capture_output=True, text=True, timeout=2)
        pos = float(pos_out.stdout.strip()) if pos_out.returncode == 0 else 0.0
    except Exception:
        pos = 0.0
    try:
        len_out = subprocess.run(["playerctl", "metadata", "mpris:length"], capture_output=True, text=True, timeout=2)
        # mpris:length is in microseconds
        length = int(len_out.stdout.strip()) / 1_000_000 if len_out.returncode == 0 else 0.0
    except Exception:
        length = 0.0
    info["position"] = pos
    info["duration"] = length
    return info


def _sleep_timer_fire():
    try:
        subprocess.run(["playerctl", "pause"], stderr=subprocess.DEVNULL)
    except Exception:
        pass
    try:
        req = urllib.request.Request(
            "http://localhost:8084/set",
            data=json.dumps({"mode": "off"}).encode(),
            headers={"Content-Type": "application/json"})
        urllib.request.urlopen(req, timeout=2)
    except Exception:
        pass
    with _sleep_timer_lock:
        global _sleep_timer, _sleep_timer_end
        _sleep_timer = None
        _sleep_timer_end = 0.0


def set_speaker_volumes(front_left, front_right, rear_left, rear_right):
    """Set individual channel volumes on each sink (0–100)."""
    subprocess.run(
        ["pactl", "set-sink-volume", FRONT_ALSA,
         f"{int(front_left)}%", f"{int(front_right)}%"],
        check=True
    )
    subprocess.run(
        ["pactl", "set-sink-volume", REAR_ALSA,
         f"{int(rear_left)}%", f"{int(rear_right)}%"],
        check=True
    )


# ── USB Line-In (pw-loopback) management ─────────────────────────────────────

_loopback_proc = None  # subprocess.Popen for pw-loopback
_scream_proc = None    # subprocess.Popen for scream-to-pipewire
_proc_lock = threading.Lock()


def start_usb_loopback():
    """Start pw-loopback: UFO202 line-in → combined or HDMI (simple profile)."""
    global _loopback_proc
    stop_usb_loopback()
    st = load_state()
    play_to = playback_loopback_target(st)
    with _proc_lock:
        _loopback_proc = subprocess.Popen(
            [
                "pw-loopback",
                "--capture-props", f"target.object={UFO202_SOURCE}",
                "--playback-props", f"target.object={play_to}",
            ],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )


def stop_usb_loopback():
    """Stop any running pw-loopback process."""
    global _loopback_proc
    with _proc_lock:
        if _loopback_proc is not None:
            try:
                _loopback_proc.terminate()
                _loopback_proc.wait(timeout=3)
            except Exception:
                try:
                    _loopback_proc.kill()
                except Exception:
                    pass
            _loopback_proc = None


_scream_start_time = None  # timestamp when scream receiver was started


def get_network_config():
    """Get network config from state, with defaults."""
    state = load_state()
    nc = state.get("network_config", {})
    return {
        "group": nc.get("group", "239.255.77.77"),
        "port": nc.get("port", 4010),
        "iface": nc.get("iface", ""),
        "unicast": nc.get("unicast", False),
        "rate": nc.get("rate", 48000),
        "format": nc.get("format", "s16"),
    }


def start_scream_receiver(config=None):
    """Start scream-to-pipewire: receive Scream audio from Windows laptop."""
    global _scream_proc, _scream_start_time
    stop_scream_receiver()
    if config is None:
        config = get_network_config()
    env = os.environ.copy()
    if config.get("group") and config["group"] != "239.255.77.77":
        env["SCREAM_GROUP"] = config["group"]
    if config.get("port") and config["port"] != 4010:
        env["SCREAM_PORT"] = str(config["port"])
    if config.get("iface"):
        env["SCREAM_IFACE"] = config["iface"]
    if config.get("unicast"):
        env["SCREAM_UNICAST"] = "1"
    if config.get("rate") and config["rate"] != 48000:
        env["SCREAM_RATE"] = str(config["rate"])
    if config.get("format") and config["format"] != "s16":
        env["SCREAM_FORMAT"] = config["format"]
    # Always receive 4 channels — Windows Scream stays in Quadraphonic (4.0).
    # PipeWire's combined sink handles channel routing based on stereo/surround mode.
    env["SCREAM_CHANNELS"] = "4"
    st = load_state()
    pt = playback_loopback_target(st)
    if pt != "combined":
        env["PI8_PLAYBACK_TARGET"] = pt
    with _proc_lock:
        _scream_proc = subprocess.Popen(
            [os.path.expanduser("~/bin/scream-to-pipewire")],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            preexec_fn=os.setsid,
            env=env,
        )
        _scream_start_time = time.time()


def stop_scream_receiver():
    """Stop any running scream receiver process."""
    global _scream_proc
    with _proc_lock:
        if _scream_proc is not None:
            try:
                import signal
                os.killpg(os.getpgid(_scream_proc.pid), signal.SIGTERM)
                _scream_proc.wait(timeout=3)
            except Exception:
                try:
                    os.killpg(os.getpgid(_scream_proc.pid), signal.SIGKILL)
                except Exception:
                    pass
            _scream_proc = None
            _scream_start_time = None


def get_scream_status():
    """Return status info for the scream receiver process."""
    global _scream_proc, _scream_start_time
    with _proc_lock:
        if _scream_proc is None:
            return {"running": False, "pid": None, "uptime_s": 0}
        poll = _scream_proc.poll()
        if poll is not None:
            _scream_proc = None
            _scream_start_time = None
            return {"running": False, "pid": None, "uptime_s": 0, "exit_code": poll}
        uptime = int(time.time() - _scream_start_time) if _scream_start_time else 0
        return {"running": True, "pid": _scream_proc.pid, "uptime_s": uptime}


def set_source(source):
    """Set active input source. Only 'usb' and 'network' require action."""
    stop_usb_loopback()
    stop_scream_receiver()
    if source == "usb":
        start_usb_loopback()
    elif source == "network":
        start_scream_receiver()

# ── PipeWire config writers ───────────────────────────────────────────────────

def write_combined(front_node, rear_node, mode="stereo", hdmi_node=None, front_rear=True):
    if mode == "surround":
        combined_pos = "FL FR RL RR"
        rear_combine_pos = "RL RR"
        desc = "Surround 4.0 (Front + Rear)"
    else:
        combined_pos = "FL FR"
        rear_combine_pos = "FL FR"
        desc = "Combined Stereo (Front + Rear)"
    parts = []
    if front_rear:
        parts.append("Front + Rear")
    if hdmi_node:
        parts.append("HDMI")
    desc = ("Surround 4.0" if mode == "surround" else "Stereo") + " — " + " + ".join(parts) if parts else "combined"

    rules = ""
    if front_rear:
        rules += f"""
        {{
          matches = [ {{ media.class = "Audio/Sink" node.name = "{front_node}" }} ]
          actions = {{ create-stream = {{ combine.audio.position = [ FL FR ] audio.position = [ FL FR ] }} }}
        }}
        {{
          matches = [ {{ media.class = "Audio/Sink" node.name = "{rear_node}" }} ]
          actions = {{ create-stream = {{ combine.audio.position = [ {rear_combine_pos} ] audio.position = [ FL FR ] }} }}
        }}"""
    if hdmi_node:
        rules += f"""
        {{
          matches = [ {{ media.class = "Audio/Sink" node.name = "{hdmi_node}" }} ]
          actions = {{ create-stream = {{ combine.audio.position = [ FL FR ] audio.position = [ FL FR ] }} }}
        }}"""

    conf = f"""\
context.modules = [
  {{ name = libpipewire-module-combine-stream
    args = {{
      combine.mode = sink
      node.name = "combined"
      node.description = "{desc}"
      combine.latency-compensate = true
      combine.props = {{ audio.position = [ {combined_pos} ] }}
      stream.props  = {{ stream.dont-remix = true }}
      stream.rules = [{rules}
      ]
    }}
  }}
]
"""
    with open(COMBINED_CONF, "w") as f:
        f.write(conf)


def write_delay(target, delay_ms):
    alsa = FRONT_ALSA if target == "front" else REAR_ALSA
    delay_s = delay_ms / 1000.0
    conf = f"""\
# Auto-generated by audio-sync-web. Do not edit.
context.modules = [
  {{ name = libpipewire-module-filter-chain
    args = {{
      node.description = "audio-sync delay ({target} +{delay_ms}ms)"
      media.name       = "audio-sync delay"
      filter.graph = {{
        nodes = [
          {{ type = builtin name = dL label = delay control = {{ "Delay (s)" = {delay_s:.6f} }} config = {{ max-delay = 1.0 }} }}
          {{ type = builtin name = dR label = delay control = {{ "Delay (s)" = {delay_s:.6f} }} config = {{ max-delay = 1.0 }} }}
        ]
        inputs  = [ "dL:In" "dR:In" ]
        outputs = [ "dL:Out" "dR:Out" ]
      }}
      audio.channels = 2
      audio.position = [ FL FR ]
      capture.props  = {{ node.name = "{DELAY_NODE}" media.class = Audio/Sink }}
      playback.props = {{ node.name = "audio-sync-out" target.object = "{alsa}" node.passive = true stream.dont-remix = true }}
    }}
  }}
]
"""
    with open(DELAY_CONF, "w") as f:
        f.write(conf)


BCM2835_LUA = os.path.expanduser("~/.config/wireplumber/main.lua.d/51-bcm2835-fix.lua")
CM108_LUA   = os.path.expanduser("~/.config/wireplumber/main.lua.d/52-cm108-fix.lua")

def write_alsa_buffer(sink_node, lua_path, period_size, headroom=None):
    """Write a WirePlumber ALSA rule for period-size and headroom."""
    if headroom is None:
        headroom = period_size
    conf = f"""rule = {{
  matches = {{
    {{
      {{ "node.name", "equals", "{sink_node}" }},
    }},
  }},
  apply_properties = {{
    ["api.alsa.period-size"]   = {period_size},
    ["api.alsa.headroom"]      = {headroom},
    ["api.alsa.disable-batch"] = true,
  }},
}}

table.insert(alsa_monitor.rules, rule)
"""
    os.makedirs(os.path.dirname(lua_path), exist_ok=True)
    with open(lua_path, "w") as f:
        f.write(conf)


def apply_buffers(front_buf, rear_buf):
    """Write ALSA buffer configs for both sinks and restart PipeWire."""
    write_alsa_buffer(FRONT_ALSA, BCM2835_LUA, front_buf)
    write_alsa_buffer(REAR_ALSA, CM108_LUA, rear_buf)


def apply_state(state):
    profile = state.get("audio_profile", "multi")
    target   = state.get("target")
    delay_ms = state.get("delay_ms", 0)
    mode     = state.get("mode", "stereo")

    # Determine HDMI node and front_rear flag
    hdmi_node  = None
    front_rear = state.get("outputs_front_rear", True)
    if state.get("hdmi_enabled"):
        port = state.get("hdmi_port", 0)
        h0, h1 = detect_hdmi_sinks()
        hdmi_node = h0 if port == 0 else h1
    # Safety: at least one output must be active
    if not front_rear and not hdmi_node:
        front_rear = True

    if profile == "simple":
        if delay_ms and target:
            log.info(
                "audio_profile=simple: ignoring sync delay (target=%s delay_ms=%s)",
                target,
                delay_ms,
            )
        if os.path.exists(DELAY_CONF):
            try:
                os.remove(DELAY_CONF)
            except OSError:
                pass
        clear_combined_conf()
    elif not target or delay_ms == 0:
        if os.path.exists(DELAY_CONF):
            os.remove(DELAY_CONF)
        write_combined(FRONT_ALSA, REAR_ALSA, mode, hdmi_node, front_rear)
    else:
        write_delay(target, delay_ms)
        front = DELAY_NODE if target == "front" else FRONT_ALSA
        rear  = DELAY_NODE if target == "rear"  else REAR_ALSA
        write_combined(front, rear, mode, hdmi_node, front_rear)

    subprocess.run(
        ["systemctl", "--user", "restart", "pipewire", "pipewire-pulse", "wireplumber"],
        check=True
    )
    # Re-apply volume balance after PipeWire restart (sinks need time to appear)
    time.sleep(2)
    state_now = load_state()
    bal = state_now.get("balance", 0)
    if profile == "multi" and bal != 0:
        try:
            apply_balance(bal)
        except subprocess.CalledProcessError:
            pass  # sinks may not be ready yet
    if profile == "simple":
        sink = hdmi_sink_for_state(state_now)
        set_default_sink_pulse(sink)
        log.info("audio_profile=simple: default sink → %s", sink)
    # Re-apply source (USB loopback / Scream — target combined or HDMI)
    source = state_now.get("source", "bluetooth")
    if source in ("usb", "network"):
        try:
            set_source(source)
        except Exception:
            pass


def load_state():
    defaults = {
        "target": None,
        "delay_ms": 0,
        "balance": 0,
        "mode": "stereo",
        "source": "bluetooth",
        "audio_profile": "multi",
    }
    if os.path.exists(STATE_FILE):
        try:
            with open(STATE_FILE) as f:
                data = json.load(f)
            if isinstance(data, dict):
                for k, v in defaults.items():
                    if k not in data:
                        data[k] = v
                return data
        except Exception:
            pass  # corrupt or empty file — fall through to defaults
    return dict(defaults)


def save_state(state):
    with open(STATE_FILE, "w") as f:
        json.dump(state, f)


# ── Sync-test tone generator ───────────────────────────────────────────────────

import math, random as _random, struct as _struct

_SAMPLE_RATE  = 48000
_CHUNK        = 512   # samples per write
_CYCLE_S      = 1.1   # seconds per beep cycle
_BEEP_S       = 0.14  # beep duration
_NOISE_AMP    = 0.04  # white noise relative amplitude (quiet background)

# Shared state for the continuous calibration stream
_calib_stop   = threading.Event()
_calib_lock   = threading.Lock()
_calib_offset = {"front": 0.0, "rear": 0.0, "volume": 0.7}  # volume 0..1


def _gen_calib_stream(sink, stop_event):
    """Continuously stream: white noise + periodic beep, with live-updatable offset."""
    freq       = 880 if sink == "front" else 330
    target_alsa = FRONT_ALSA if sink == "front" else REAR_ALSA
    CYCLE_N    = int(_CYCLE_S * _SAMPLE_RATE)
    BEEP_N     = int(_BEEP_S  * _SAMPLE_RATE)
    ATTACK     = int(0.004 * _SAMPLE_RATE)
    RELEASE    = int(0.025 * _SAMPLE_RATE)

    # WAV header with "unknown" size so pw-cat streams indefinitely
    hdr = _struct.pack('<4sI4s4sIHHIIHH4sI',
        b'RIFF', 0x7FFFFFFF, b'WAVE',
        b'fmt ', 16, 1, 1, _SAMPLE_RATE, _SAMPLE_RATE * 2, 2, 16,
        b'data', 0x7FFFFFFF)

    proc = subprocess.Popen(
        ["pw-cat", "--playback", f"--target={target_alsa}",
         "--format=s16", f"--rate={_SAMPLE_RATE}", "--channels=1", "-"],
        stdin=subprocess.PIPE, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    _calib_procs.append(proc)

    try:
        proc.stdin.write(hdr)
        pos = 0
        while not stop_event.is_set():
            with _calib_lock:
                offset_s = _calib_offset[sink]
                vol      = _calib_offset["volume"]
            amp       = vol * 0.6
            offset_n  = max(0, int(offset_s * _SAMPLE_RATE / 1000))
            beep_start = offset_n % CYCLE_N

            chunk = []
            for _ in range(_CHUNK):
                p = pos % CYCLE_N
                # white noise background
                s = _random.gauss(0, _NOISE_AMP * amp) * 32767
                # beep
                bi = p - beep_start
                if 0 <= bi < BEEP_N:
                    t   = bi / _SAMPLE_RATE
                    env = min(bi / max(ATTACK,1), 1.0) * min((BEEP_N-bi) / max(RELEASE,1), 1.0)
                    s  += amp * env * math.sin(2 * math.pi * freq * t) * 32767
                chunk.append(max(-32768, min(32767, int(s))))
                pos += 1

            proc.stdin.write(_struct.pack(f'<{_CHUNK}h', *chunk))
    except BrokenPipeError:
        pass
    finally:
        try:
            proc.terminate()
        except Exception:
            pass


_calib_threads = []
_calib_procs   = []  # pw-cat subprocesses, for early kill on stop


def start_calib_stream(front_offset_ms, rear_offset_ms, volume):
    global _calib_threads, _calib_procs
    stop_calib_stream()
    with _calib_lock:
        _calib_offset["front"]  = front_offset_ms
        _calib_offset["rear"]   = rear_offset_ms
        _calib_offset["volume"] = max(0.05, min(1.0, volume / 100))
    _calib_stop.clear()
    _calib_procs = []
    _calib_threads = [
        threading.Thread(target=_gen_calib_stream, args=("front", _calib_stop), daemon=True),
        threading.Thread(target=_gen_calib_stream, args=("rear",  _calib_stop), daemon=True),
    ]
    for t in _calib_threads:
        t.start()

def update_calib_offset(front_offset_ms, rear_offset_ms, volume):
    """Live-update the offset without restarting the stream."""
    with _calib_lock:
        _calib_offset["front"]  = front_offset_ms
        _calib_offset["rear"]   = rear_offset_ms
        _calib_offset["volume"] = max(0.05, min(1.0, volume / 100))

def stop_calib_stream():
    _calib_stop.set()
    # Kill pw-cat subprocesses first so threads unblock immediately
    for p in list(_calib_procs):
        try:
            p.terminate()
        except Exception:
            pass
    for t in _calib_threads:
        t.join(timeout=1)


def play_sync_test(front_offset_ms=0.0, rear_offset_ms=0.0):
    """One-shot: play beeps with offset baked in as silence prefix (legacy)."""
    front_wav = _wrap_wav(b'\x00' * max(0, int(front_offset_ms * _SAMPLE_RATE / 1000)) * 2
                          + _make_beep_samples(880))
    rear_wav  = _wrap_wav(b'\x00' * max(0, int(rear_offset_ms  * _SAMPLE_RATE / 1000)) * 2
                          + _make_beep_samples(330))
    procs = [
        subprocess.Popen(["pw-cat", "--playback", f"--target={FRONT_ALSA}", "-"],
                         stdin=subprocess.PIPE, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL),
        subprocess.Popen(["pw-cat", "--playback", f"--target={REAR_ALSA}", "-"],
                         stdin=subprocess.PIPE, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL),
    ]
    procs[0].stdin.write(front_wav); procs[0].stdin.close()
    procs[1].stdin.write(rear_wav);  procs[1].stdin.close()
    for p in procs:
        p.wait(timeout=5)

def _make_beep_samples(freq, duration_s=0.14, amplitude=0.7):
    n       = int(duration_s * _SAMPLE_RATE)
    attack  = int(0.004 * _SAMPLE_RATE)
    release = int(0.025 * _SAMPLE_RATE)
    samples = []
    for i in range(n):
        t = i / _SAMPLE_RATE
        v = amplitude * math.sin(2 * math.pi * freq * t)
        env = min(i / max(attack, 1), 1.0) * min((n - i) / max(release, 1), 1.0)
        samples.append(max(-32768, min(32767, int(v * env * 32767))))
    return _struct.pack(f'<{n}h', *samples)

def _wrap_wav(pcm_bytes):
    hdr = _struct.pack('<4sI4s4sIHHIIHH4sI',
        b'RIFF', 36 + len(pcm_bytes), b'WAVE',
        b'fmt ', 16, 1, 1, _SAMPLE_RATE, _SAMPLE_RATE * 2, 2, 16,
        b'data', len(pcm_bytes))
    return hdr + pcm_bytes


# ── Presets ────────────────────────────────────────────────────────────────────

PRESET_KEYS = ("source", "network_config", "buffer_front", "buffer_rear",
               "delay_ms", "target", "mode", "balance", "hdmi_enabled", "hdmi_port",
               "outputs_front_rear", "audio_profile")

def get_presets():
    state = load_state()
    return state.get("presets", {})

def save_preset(name, preset_state):
    state = load_state()
    presets = state.setdefault("presets", {})
    presets[name] = {k: preset_state.get(k) for k in PRESET_KEYS}
    save_state(state)

def delete_preset(name):
    state = load_state()
    state.get("presets", {}).pop(name, None)
    save_state(state)

def save_preset_schedule(name, schedule):
    """Update (or remove) the schedule field on an existing preset."""
    state = load_state()
    presets = state.setdefault("presets", {})
    if name not in presets:
        return False
    if schedule:
        presets[name]["schedule"] = schedule
    else:
        presets[name].pop("schedule", None)
    save_state(state)
    return True

def load_preset(name):
    """Apply a preset: merge into current state and apply."""
    presets = get_presets()
    if name not in presets:
        return False, "Preset nicht gefunden"
    preset = presets[name]
    state  = load_state()
    for k, v in preset.items():
        if k == "schedule":
            continue  # schedule is metadata, not an audio state key
        if v is not None:
            state[k] = v
    save_state(state)
    # Apply buffer config
    apply_buffers(state.get("buffer_front", 2048), state.get("buffer_rear", 512))
    # Apply PipeWire (delay / combined)
    with _apply_lock:
        apply_state(state)
    # Apply source
    src = state.get("source", "bluetooth")
    if src in ("usb", "network"):
        set_source(src)
    return True, f"Preset '{name}' geladen."


def _preset_scheduler():
    import datetime
    while True:
        try:
            now = datetime.datetime.now()
            current_time = now.strftime("%H:%M")
            current_day  = now.strftime("%a").lower()  # "mon", "tue", etc.
            state = load_state()
            for name, preset in state.get("presets", {}).items():
                sched = preset.get("schedule")
                if not sched:
                    continue
                if sched.get("time") != current_time:
                    continue
                days = [d.lower() for d in sched.get("days", [])]
                if days and current_day not in days:
                    continue
                fire_key = f"{now.strftime('%Y-%m-%d')} {current_time}"
                if _last_schedule_fire.get(name) == fire_key:
                    continue  # already fired this minute
                _last_schedule_fire[name] = fire_key
                print(f"[scheduler] auto-applying preset: {name}")
                load_preset(name)
        except Exception as e:
            print(f"[scheduler] error: {e}")
        now = time.time()
        sleep_secs = 60 - (now % 60) + 0.5  # wake 0.5s into next minute
        time.sleep(sleep_secs)


