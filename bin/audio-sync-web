    try {
      const res = await fetch('/restart-service', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({ service: svc, scope })
      });
      const data = await res.json();
      svcStatus.style.color = data.ok ? '#4c4' : '#f44';
      svcStatus.textContent = data.msg;
    } catch(e) {
      svcStatus.style.color = '#f44';
      svcStatus.textContent = 'Fehler: ' + e;
    }
    document.querySelectorAll('.svc-btn').forEach(b => b.disabled = false);
  });
});

// ── Sync calibration game (Simulated Annealing) ───────────────────────────────
const calib = { delay: 0, temp: 50, steps: 0, streaming: false };

function calibVol()     { return parseFloat(document.getElementById('vol-slider')?.value || 70); }
function calibTemp()    { return parseFloat(document.getElementById('calib-init-temp').value)  || 50; }
function calibCooling() { return parseFloat(document.getElementById('calib-cooling').value)    || 0.75; }
function calibMinTemp() { return parseFloat(document.getElementById('calib-min-temp').value)   || 0.5; }

function fmtMs(v) {
  const a = Math.abs(v);
  return a === 0 ? '0 ms' : a >= 10 ? a.toFixed(1)+' ms' : a >= 1 ? a.toFixed(2)+' ms' : a.toFixed(3)+' ms';
}

function updateCalibDisplay() {
  const who = calib.delay > 0.001 ? 'Front +' : calib.delay < -0.001 ? 'Rear +' : '';
  const abs = Math.abs(calib.delay);
  document.getElementById('calib-delay-display').textContent = fmtMs(calib.delay);
  document.getElementById('calib-delay-display').style.color = calib.delay > 0 ? '#faa' : calib.delay < 0 ? '#aaf' : '#4af';
  document.getElementById('calib-who-display').textContent   = who ? `${who}${fmtMs(abs)} Offset` : 'kein Offset';
  document.getElementById('calib-step-display').textContent  = fmtMs(calib.temp);
  document.getElementById('calib-step-display').style.color  = calib.temp > 10 ? '#fa8' : calib.temp > 2 ? '#ff8' : '#8f8';
  document.getElementById('calib-steps-display').textContent = calib.steps;
  const vol = calibVol();
  document.getElementById('calib-vol-display').textContent = vol + '%';
}

async function calibStreamCall(action) {
  const fo = Math.max(0,  calib.delay);
  const ro = Math.max(0, -calib.delay);
  await fetch('/calib-stream', {
    method: 'POST', headers: {'Content-Type':'application/json'},
    body: JSON.stringify({ action, front_offset_ms: fo, rear_offset_ms: ro, volume: calibVol() })
  });
}

const calibPlayBtn = document.getElementById('calib-play-btn');
calibPlayBtn.addEventListener('click', async () => {
  if (!calib.streaming) {
    calib.streaming = true;
    calibPlayBtn.textContent = '⏹ Stream stoppen';
    calibPlayBtn.style.background = '#3a1a1a';
    calibPlayBtn.style.color = '#faa';
    calibPlayBtn.style.borderColor = '#644';
    await calibStreamCall('start');
  } else {
    calib.streaming = false;
    calibPlayBtn.textContent = '▶ Stream starten';
    calibPlayBtn.style.background = '#1a3a1a';
    calibPlayBtn.style.color = '#8f8';
    calibPlayBtn.style.borderColor = '#464';
    await calibStreamCall('stop');
  }
});

// Update volume display whenever vol slider changes
document.getElementById('vol-slider')?.addEventListener('input', () => {
  updateCalibDisplay();
  if (calib.streaming) calibStreamCall('update');
});

async function calibAdjust(dir) {
  const noise = calib.temp * 0.1 * (Math.random() * 2 - 1);
  const step  = Math.max(calibMinTemp(), calib.temp + noise);
  calib.delay += dir * step;
  calib.temp   = Math.max(calibMinTemp(), calib.temp * calibCooling());
  calib.steps += 1;
  updateCalibDisplay();
  document.getElementById('calib-front-btn').disabled = true;
  document.getElementById('calib-rear-btn').disabled  = true;
  if (calib.streaming) {
    await calibStreamCall('update');  // live update, no restart
  }
  document.getElementById('calib-front-btn').disabled = false;
  document.getElementById('calib-rear-btn').disabled  = false;
  if (calib.temp <= calibMinTemp()) {
    document.getElementById('calib-status').style.color = '#afa';
    document.getElementById('calib-status').textContent =
      `✓ Min-Temp erreicht (${fmtMs(calibMinTemp())}) — bereit zum Übernehmen!`;
  }
}

document.getElementById('calib-front-btn').addEventListener('click', () => calibAdjust(+1));
document.getElementById('calib-rear-btn').addEventListener('click',  () => calibAdjust(-1));

document.getElementById('calib-reset-btn').addEventListener('click', async () => {
  calib.delay = 0; calib.temp = calibTemp(); calib.steps = 0;
  updateCalibDisplay();
  document.getElementById('calib-status').textContent = '';
  if (calib.streaming) await calibStreamCall('update');
});

document.getElementById('calib-init-temp').addEventListener('change', () => {
  if (calib.steps === 0) { calib.temp = calibTemp(); updateCalibDisplay(); }
});

document.getElementById('calib-sync-btn').addEventListener('click', async () => {
  const st = document.getElementById('calib-status');
  if (calib.streaming) { calib.streaming = false; await calibStreamCall('stop'); }
  const target   = calib.delay >= 0 ? 'front' : 'rear';
  const delay_ms = parseFloat(Math.abs(calib.delay).toFixed(3));
  st.style.color = '#fa0'; st.textContent = 'Delay wird angewendet…';
  try {
    const res = await fetch('/apply', {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ target: delay_ms > 0 ? target : null, delay_ms })
    });
    if (res.status === 202) {
      const pollApply = setInterval(async () => {
        try {
          const s = await fetch('/apply-status').then(r => r.json());
          if (s.state === 'done' || s.state === 'error') {
            clearInterval(pollApply);
            if (s.state === 'error') {
              st.style.color = '#f44';
              st.textContent = 'Fehler: ' + (s.error || 'unbekannt');
            } else {
              st.style.color = '#4c4';
              st.textContent = `✓ ${delay_ms}ms auf ${target} angewendet!`;
              slider.value = delay_ms; targetSel.value = target; updateDisplay();
              calibPlayBtn.textContent = '▶ Stream starten';
              calibPlayBtn.style.background = '#1a3a1a'; calibPlayBtn.style.color = '#8f8'; calibPlayBtn.style.borderColor = '#464';
            }
          }
        } catch(e) { /* ignore poll errors */ }
      }, 500);
    } else {
      const d = await res.json();
      st.style.color = d.ok ? '#4c4' : '#f44';
      st.textContent = d.ok ? `✓ ${delay_ms}ms auf ${target} angewendet!` : (d.error || d.msg);
      if (d.ok) {
        slider.value = delay_ms; targetSel.value = target; updateDisplay();
        calibPlayBtn.textContent = '▶ Stream starten';
        calibPlayBtn.style.background = '#1a3a1a'; calibPlayBtn.style.color = '#8f8'; calibPlayBtn.style.borderColor = '#464';
      }
    }
  } catch(e) { st.style.color = '#f44'; st.textContent = 'Fehler: ' + e; }
});

// Stop stream when panel is closed
document.getElementById('sync-game-panel').addEventListener('toggle', async (e) => {
  if (!e.target.open && calib.streaming) {
    calib.streaming = false;
    await calibStreamCall('stop');
    calibPlayBtn.textContent = '▶ Stream starten';
    calibPlayBtn.style.background = '#1a3a1a'; calibPlayBtn.style.color = '#8f8'; calibPlayBtn.style.borderColor = '#464';
  }
});

updateCalibDisplay();
// ── Presets ───────────────────────────────────────────────────────────────────
function escHtml(s) {
  return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

function renderPresets(presets) {
  const list = document.getElementById('presets-list');
  list.innerHTML = '';
  const names = Object.keys(presets);
  if (!names.length) {
    list.innerHTML = '<div style="color:#555;font-size:0.8rem;text-align:center">Keine Presets gespeichert</div>';
    return;
  }
  const allDays = ['mon','tue','wed','thu','fri','sat','sun'];
  names.forEach(name => {
    const p = presets[name];
    const info = [
      p.source || '?',
      p.mode || '',
      p.target && p.delay_ms ? `${p.target}+${p.delay_ms}ms` : 'kein Delay',
    ].filter(Boolean).join(' · ');
    const sched = p.schedule || {};
    const schedHtml = `
      <div style="margin-top:0.4rem;display:flex;gap:0.4rem;align-items:center;flex-wrap:wrap">
        <input type="time" value="${escHtml(sched.time||'')}"
          style="background:#1a1a1a;color:#ccc;border:1px solid #444;border-radius:4px;padding:0.2rem 0.4rem;font-size:0.8rem"
          onchange="setPresetScheduleTime(${JSON.stringify(name)}, this.value)">
        <div style="display:flex;gap:0.2rem">
          ${allDays.map(d => `<button class="day-btn${(sched.days||[]).includes(d) ? ' active' : ''}"
            onclick="togglePresetDay(${JSON.stringify(name)}, '${d}', this)"
            title="${d}">${d[0].toUpperCase()}</button>`).join('')}
        </div>
      </div>`;
    const row = document.createElement('div');
    row.style.cssText = 'background:#1a1a1a;border-radius:6px;padding:0.5rem 0.6rem';
    row.innerHTML = `
      <div style="display:flex;gap:0.4rem;align-items:center">
        <div style="flex:1;min-width:0;overflow:hidden">
          <div style="font-weight:700;color:#ddd;font-size:1rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${escHtml(name)}</div>
          <div style="font-size:0.72rem;color:#666;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${escHtml(info)}</div>
        </div>
        <button onclick="loadPreset(${JSON.stringify(name)})"
          style="padding:0.35rem 0.7rem;background:#1a3a1a;color:#8f8;border:1px solid #464;border-radius:6px;font-size:0.85rem;cursor:pointer;white-space:nowrap;flex-shrink:0">▶ Laden</button>
        <button onclick="deletePreset(${JSON.stringify(name)})"
          style="padding:0.35rem 0.55rem;background:#2a1a1a;color:#f88;border:1px solid #644;border-radius:6px;font-size:0.85rem;cursor:pointer;flex-shrink:0">✕</button>
      </div>
      ${schedHtml}
    `;
    list.appendChild(row);
  });
}

async function loadPreset(name) {
  const st = document.getElementById('preset-status');
  st.style.color = '#fa0'; st.textContent = `Lade '${name}'…`;
  const res = await fetch('/presets/load', {method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({name})});
  const d = await res.json();
  st.style.color = d.ok ? '#4c4' : '#f44';
  st.textContent = d.msg;
  if (d.ok) setTimeout(() => location.reload(), 1500);
}

async function deletePreset(name) {
  if (!confirm(`Preset '${name}' löschen?`)) return;
  const res = await fetch('/presets/delete', {method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({name})});
  const d = await res.json();
  renderPresets(d.presets || {});
}

document.getElementById('preset-save-btn').addEventListener('click', async () => {
  const name = document.getElementById('preset-name-input').value.trim();
  const st   = document.getElementById('preset-status');
  if (!name) { st.style.color='#f44'; st.textContent='Name eingeben!'; return; }
  st.style.color = '#fa0'; st.textContent = 'Speichern…';
  const res = await fetch('/presets', {method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({name})});
  const d = await res.json();
  st.style.color = d.ok ? '#4c4' : '#f44';
  st.textContent = d.msg;
  if (d.ok) { renderPresets(d.presets); document.getElementById('preset-name-input').value = ''; }
});

// Load presets on start
fetch('/presets').then(r => r.json()).then(d => renderPresets(d.presets || {}));

async function setPresetScheduleTime(name, timeVal) {
  const state = await fetch('/state').then(r => r.json());
  const preset = (state.presets || {})[name];
  if (!preset) return;
  let schedule = preset.schedule ? Object.assign({}, preset.schedule) : {};
  if (timeVal) {
    schedule.time = timeVal;
    if (!schedule.days) schedule.days = ['mon','tue','wed','thu','fri','sat','sun'];
  } else {
    schedule = null;
  }
  const res = await fetch('/presets/schedule', {method:'POST', headers:{'Content-Type':'application/json'},
    body: JSON.stringify({name, schedule})});
  const d = await res.json();
  if (d.ok) renderPresets(d.presets);
}

async function togglePresetDay(name, day, btn) {
  const state = await fetch('/state').then(r => r.json());
  const preset = (state.presets || {})[name];
  if (!preset) return;
  const schedule = preset.schedule ? Object.assign({}, preset.schedule, {days: [...(preset.schedule.days || [])]}) : {days: []};
  const days = schedule.days;
  const idx = days.indexOf(day);
  if (idx >= 0) days.splice(idx, 1); else days.push(day);
  schedule.days = days;
  const res = await fetch('/presets/schedule', {method:'POST', headers:{'Content-Type':'application/json'},
    body: JSON.stringify({name, schedule})});
  const d = await res.json();
  if (d.ok) btn.classList.toggle('active');
}
</script>
</body>
</html>
"""

