        document.getElementById("scene-status").textContent = "…";
        try {
          const res = await fetch("/scene/apply", {method:"POST",
            headers:{"Content-Type":"application/json"},
            body: JSON.stringify({name: s.name})});
          const j = await res.json();
          document.getElementById("scene-status").textContent =
            res.ok ? "OK" : (j.msg || "error");
        } catch (e) {
          document.getElementById("scene-status").textContent = String(e);
        }
        renderModes();
      };
      el.appendChild(b);
    }
  } catch (e) {
    el.textContent = "Scenes unavailable";
  }
}
renderModes();
renderScenes();
</script>
</body>
</html>
