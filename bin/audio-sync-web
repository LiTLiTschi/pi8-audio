<script>
const MODES = ["off","now-playing","visualizer","music-video"];
async function fetchDispMode() {
  try {
    const r = await fetch("/display-state", {cache:"no-store"});
    const j = await r.json();
    return j.mode || "off";
  } catch (e) { return "off"; }
}
async function renderModes() {
  const cur = await fetchDispMode();
  const el = document.getElementById("modes");
  el.innerHTML = "";
  for (const m of MODES) {
