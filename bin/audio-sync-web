<script>
const slider   = document.getElementById('delay-slider');
const msBig    = document.getElementById('ms-big');
const msLabel  = document.getElementById('ms-label');
const applyBtn = document.getElementById('apply-btn');
const resetBtn = document.getElementById('reset-btn');
const status   = document.getElementById('status');
const targetSel = document.getElementById('target');
const delayMin = document.getElementById('delay-min');
const delayMax = document.getElementById('delay-max');

function updateDisplay() {
  const v = parseFloat(slider.value);
  const txt = v % 1 === 0 ? v + ' ms' : (parseFloat(slider.step) <= 0.01 ? v.toFixed(2) : v.toFixed(1)) + ' ms';
  msBig.textContent  = txt;
  msLabel.textContent = txt;
}

function updateSliderRange() {
  const lo = parseFloat(delayMin.value) || 0;
  const hi = parseFloat(delayMax.value) || 200;
  slider.min = lo;
  slider.max = hi;
  // Auto step: 0.01 when range ≤ 5ms, 0.1 when ≤ 50ms, 1 otherwise
  slider.step = (hi - lo) <= 5 ? 0.01 : ((hi - lo) <= 50 ? 0.1 : 1);
  if (parseFloat(slider.value) < lo) slider.value = lo;
  if (parseFloat(slider.value) > hi) slider.value = hi;
  updateDisplay();
}

delayMin.addEventListener('change', updateSliderRange);
delayMax.addEventListener('change', updateSliderRange);

slider.addEventListener('input', updateDisplay);
updateDisplay();

async function applyDelay(target, delay_ms) {
  applyBtn.disabled = true;
  status.className = 'loading';
  status.textContent = 'Wende an… PipeWire wird neu gestartet…';
  try {
    const res = await fetch('/apply', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({ target, delay_ms: parseFloat(delay_ms) })
    });
    if (res.status === 202) {
      const pollApply = setInterval(async () => {
        try {
          const s = await fetch('/apply-status').then(r => r.json());
          if (s.state === 'done' || s.state === 'error') {
            clearInterval(pollApply);
            applyBtn.disabled = false;
            if (s.state === 'error') {
              status.className = 'err';
              status.textContent = 'Fehler: ' + (s.error || 'unbekannt');
            } else {
              status.className = 'ok';
              status.textContent = target
                ? (parseFloat(delay_ms) === 0 ? 'Kein Delay — auto latency-compensate aktiv.' : (target === 'front' ? '3.5mm Front' : 'USB Rear') + ' +' + parseFloat(delay_ms) + 'ms Delay angewendet.')
                : 'Kein Delay — auto latency-compensate aktiv.';
            }
          }
        } catch(e) { /* ignore poll errors */ }
      }, 500);
    } else {
      const data = await res.json();
      if (data.ok) {
        status.className = 'ok';
        status.textContent = data.msg;
      } else {
        status.className = 'err';
        status.textContent = 'Fehler: ' + (data.error || data.msg);
      }
      applyBtn.disabled = false;
    }
  } catch(e) {
    status.className = 'err';
    status.textContent = 'Netzwerkfehler: ' + e;
    applyBtn.disabled = false;
  }
}

applyBtn.addEventListener('click', () => {
  const t = targetSel.value === 'none' ? null : targetSel.value;
  applyDelay(t, slider.value);
});

resetBtn.addEventListener('click', () => {
  targetSel.value = 'none';
  slider.value = 0;
  updateDisplay();
  applyDelay(null, 0);
});

// Load current state
let _netConfigLoaded = false;
fetch('/state').then(r => r.json()).then(s => {
  if (s.target) targetSel.value = s.target;
  if (s.delay_ms) { slider.value = s.delay_ms; updateDisplay(); }
  if (s.balance != null) { balSlider.value = s.balance; updateBalDisplay(); }
  if (s.mode) setModeUI(s.mode);
  if (s.source) setSourceUI(s.source);
  if (s.buffer_front) document.getElementById('buf-front').value = s.buffer_front;
  if (s.buffer_rear)  document.getElementById('buf-rear').value  = s.buffer_rear;
  if (s.hdmi_enabled        != null) document.getElementById('hdmi-enabled').checked  = s.hdmi_enabled;
  if (s.hdmi_port           != null) document.getElementById('hdmi-port').value        = s.hdmi_port;
  if (s.outputs_front_rear  != null) document.getElementById('out-front-rear').checked = s.outputs_front_rear;
  updateContextUI();
});

// ── Buffer apply ──
document.getElementById('buf-apply-btn').addEventListener('click', async () => {
  const btn = document.getElementById('buf-apply-btn');
  btn.disabled = true;
  status.className = 'loading';
  status.textContent = 'Buffer wird angewendet… PipeWire wird neu gestartet…';
  try {
    const res = await fetch('/buffers', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({
        front: parseInt(document.getElementById('buf-front').value),
        rear:  parseInt(document.getElementById('buf-rear').value)
      })
    });
    const data = await res.json();
    status.className = data.ok ? 'ok' : 'err';
    status.textContent = data.msg || 'Fehler';
  } catch(e) {
    status.className = 'err';
    status.textContent = 'Netzwerkfehler: ' + e;
  }
  btn.disabled = false;
});
function setModeUI(mode) {
  document.getElementById('mode-stereo').classList.toggle('active', mode === 'stereo');
  document.getElementById('mode-surround').classList.toggle('active', mode === 'surround');
}

async function switchMode(mode) {
  setModeUI(mode);
  status.className = 'loading';
  status.textContent = 'Modus wird gewechselt… PipeWire wird neu gestartet…';
  try {
    const res = await fetch('/mode', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({ mode })
    });
    const data = await res.json();
    if (data.ok) { status.className = 'ok'; status.textContent = data.msg; }
    else { status.className = 'err'; status.textContent = 'Fehler: ' + data.msg; }
  } catch(e) { status.className = 'err'; status.textContent = 'Netzwerkfehler: ' + e; }
}

// ── Output toggles ──
function updateContextUI() {
  const hasFrontRear = document.getElementById('out-front-rear').checked;
  const hasHdmi      = document.getElementById('hdmi-enabled').checked;
  // Must keep at least one output active
  if (!hasFrontRear && !hasHdmi) {
    document.getElementById('out-front-rear').checked = true;
    return;
  }
  document.getElementById('section-delay').style.display = hasFrontRear ? '' : 'none';
}

async function applyOutputs() {
  const frontRear = document.getElementById('out-front-rear').checked;
  const enabled   = document.getElementById('hdmi-enabled').checked;
  const port      = parseInt(document.getElementById('hdmi-port').value);
  updateContextUI();
  status.className = 'loading';
  status.textContent = 'Outputs werden angewendet… PipeWire neu starten…';
  try {
    const res = await fetch('/hdmi', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({ enabled, port, outputs_front_rear: frontRear })
    });
    const data = await res.json();
    if (data.ok) { status.className = 'ok'; status.textContent = data.msg; }
    else { status.className = 'err'; status.textContent = 'Fehler: ' + data.msg; }
  } catch(e) { status.className = 'err'; status.textContent = 'Netzwerkfehler: ' + e; }
}

document.getElementById('out-front-rear').addEventListener('change', applyOutputs);
document.getElementById('hdmi-enabled').addEventListener('change', applyOutputs);
document.getElementById('hdmi-port').addEventListener('change', () => {
  if (document.getElementById('hdmi-enabled').checked) applyOutputs();
});

// ── Tab switching ──
function switchTab(name) {
  document.querySelectorAll('.tab-pane').forEach(p => p.classList.remove('active'));
  document.querySelectorAll('.tab-bar-btn').forEach(b => b.classList.remove('active'));
  document.getElementById('tab-' + name)?.classList.add('active');
  document.querySelectorAll('.tab-bar-btn').forEach(b => {
    if (b.textContent.includes(name === 'audio' ? '🎵' : '🖥'))
      b.classList.add('active');
  });
  if (name === 'display') loadDisplayState();
}

// ── Display control ──
let _dispMode = 'off';
let _dispPollTimer = null;
const _dispStatusText = {
  idle: 'No player connected',
  playing: null,  // set dynamically
  searching: 'Searching for video\u2026',
  no_videos_found: 'No videos found \u2014 switched to Now Playing',
  cava_unavailable: 'cava not installed \u2014 visualizer unavailable',
  fb_permission_error: 'Framebuffer error \u2014 add liu to video group',
  daemon_down: 'Display service unavailable',
};

async function loadDisplayState() {
  try {
    const s = await fetch('/display-state').then(r => r.json());
    _dispMode = s.mode;
    const daemonDown = s.status === 'daemon_down';
    document.querySelectorAll('.disp-btn').forEach(b => {
      b.classList.remove('active');
      b.disabled = daemonDown;
      b.style.opacity = daemonDown ? '0.4' : '';
      b.style.cursor  = daemonDown ? 'not-allowed' : '';
    });
    if (!daemonDown) {
      const map = {'off':'disp-off','now-playing':'disp-np','visualizer':'disp-vis','music-video':'disp-video'};
      document.getElementById(map[s.mode])?.classList.add('active');
    }
    document.getElementById('disp-overlay-row').style.display = s.mode === 'now-playing' ? '' : 'none';
    document.getElementById('disp-mirror-row').style.display  = s.mode === 'visualizer'  ? '' : 'none';
    document.getElementById('disp-theme-row').style.display =
      s.mode === 'visualizer' ? '' : 'none';
    // update active theme button
    document.querySelectorAll('.theme-btn').forEach(b => b.classList.remove('active'));
    document.getElementById('theme-' + (s.visualizer_theme || 'default'))?.classList.add('active');
    document.getElementById('disp-overlay').checked = !!s.overlay_enabled;
    document.getElementById('disp-mirror').checked  = !!s.visualizer_mirror;
    document.getElementById('disp-lyrics').checked  = s.lyrics_enabled !== false;
    const t = s.track;
    const statusEl = document.getElementById('disp-status');
    if (s.status === 'playing' && t && (t.title || t.artist)) {
      statusEl.textContent = `Playing: ${t.title || '?'} \u2014 ${t.artist || '?'}`;
    } else {
      statusEl.textContent = _dispStatusText[s.status] || s.status;
    }
  } catch(e) {
    document.getElementById('disp-status').textContent = 'Display service unavailable';
    document.querySelectorAll('.disp-btn').forEach(b => {
      b.disabled = true; b.style.opacity = '0.4'; b.style.cursor = 'not-allowed';
    });
  }
  updateSleepStatus();
}

async function setDisplayMode(mode) {
  // Immediate visual feedback
  document.querySelectorAll('.disp-btn').forEach(b => b.classList.remove('active'));
  const map = {'off':'disp-off','now-playing':'disp-np','visualizer':'disp-vis','music-video':'disp-video'};
  const btn = document.getElementById(map[mode]);
  if (btn) { btn.classList.add('active'); btn.textContent = '\u23f3 ' + btn.textContent.replace(/^\u23f3 /,''); }

  const s = { mode,
    overlay_enabled: document.getElementById('disp-overlay').checked,
    visualizer_mirror: document.getElementById('disp-mirror').checked,
    lyrics_enabled: document.getElementById('disp-lyrics').checked };
  await fetch('/display', {method:'POST',
    headers:{'Content-Type':'application/json'}, body: JSON.stringify(s)});
  loadDisplayState();
}

async function applyDisplayOptions() {
  const body = {mode: _dispMode, overlay_enabled: document.getElementById('disp-overlay').checked,
                visualizer_mirror: document.getElementById('disp-mirror').checked,
                lyrics_enabled: document.getElementById('disp-lyrics').checked};
  await fetch('/display', {method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(body)});
}

async function loadHistory() {
  try {
    const entries = await fetch('/display-history').then(r => r.json());
    const el = document.getElementById('history-list');
    if (!entries.length) {
      el.innerHTML = '<div style="color:#555;font-size:0.85rem;text-align:center;padding:1rem">No history yet</div>';
      return;
    }
    el.innerHTML = entries.slice(0, 50).map(e => `
      <div style="padding:0.4rem 0;border-bottom:1px solid #222;font-size:0.85rem">
        <div style="color:#ddd">${escHtml(e.title || '—')}</div>
        <div style="color:#888;font-size:0.78rem">${escHtml(e.artist || '')}${e.album ? ' · ' + escHtml(e.album) : ''} <span style="color:#555;float:right">${e.ts.slice(11,16)}</span></div>
      </div>`).join('');
  } catch(e) { /* ignore */ }
}

document.getElementById('history-panel')?.addEventListener('toggle', e => {
  if (e.target.open) loadHistory();
});

async function setVisTheme(theme) {
  await fetch('/display', {method:'POST',
    headers:{'Content-Type':'application/json'},
    body: JSON.stringify({mode: _dispMode, visualizer_theme: theme})});
  loadDisplayState();
}

async function setSleepTimer() {
  const mins = document.getElementById('sleep-mins').value;
  await fetch('/sleep-timer', {method:'POST', headers:{'Content-Type':'application/json'},
    body: JSON.stringify({minutes: parseInt(mins)})});
  updateSleepStatus();
}
async function cancelSleepTimer() {
  await fetch('/sleep-timer', {method:'DELETE'});
  document.getElementById('sleep-status').textContent = '';
}
async function updateSleepStatus() {
  try {
    const s = await fetch('/sleep-timer').then(r => r.json());
    const el = document.getElementById('sleep-status');
    if (s.active) {
      const m = Math.floor(s.remaining_seconds / 60);
      const sec = s.remaining_seconds % 60;
      el.textContent = `⏱ ${m}:${String(sec).padStart(2,'0')} remaining`;
    } else {
      el.textContent = '';
    }
  } catch(e) {}
}

document.getElementById('display-panel').addEventListener('toggle', e => {
  if (e.target.open) {
    loadDisplayState();
    _dispPollTimer = setInterval(loadDisplayState, 3000);
  } else {
    clearInterval(_dispPollTimer);
    _dispPollTimer = null;
  }
});

// ── Power management ──
async function powerAction(action) {
  const svcStatus = document.getElementById('svc-status');
  document.querySelectorAll('.svc-btn, #power-stop-btn, #power-start-btn').forEach(b => b.disabled = true);
  svcStatus.style.color = '#fa0';
  svcStatus.textContent = action === 'stop' ? 'System wird gestoppt…' : 'System wird gestartet…';
  try {
    const res = await fetch('/power', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({ action })
    });
    const data = await res.json();
    svcStatus.style.color = data.ok ? '#4c4' : '#f44';
    svcStatus.textContent = data.msg || (data.ok ? 'Fertig.' : 'Fehler');
  } catch(e) {
    svcStatus.style.color = '#f44';
    svcStatus.textContent = 'Fehler: ' + e;
  }
  document.querySelectorAll('.svc-btn, #power-stop-btn, #power-start-btn').forEach(b => b.disabled = false);
}

// ── Source toggle ──
function setSourceUI(source) {
  document.getElementById('src-bluetooth').classList.toggle('active', source === 'bluetooth');
  document.getElementById('src-local').classList.toggle('active', source === 'local');
  document.getElementById('src-usb').classList.toggle('active', source === 'usb');
  document.getElementById('src-network').classList.toggle('active', source === 'network');
  document.getElementById('net-panel').classList.toggle('visible', source === 'network');
  if (source === 'network') { pollNetStatus(); startNetPoll(); } else { stopNetPoll(); }
}

async function switchSource(source) {
  setSourceUI(source);
  status.className = 'loading';
  status.textContent = 'Quelle wird gewechselt…';
  try {
    const res = await fetch('/source', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({ source })
    });
    const data = await res.json();
    if (data.ok) { status.className = 'ok'; status.textContent = data.msg; }
    else { status.className = 'err'; status.textContent = 'Fehler: ' + data.msg; }
  } catch(e) { status.className = 'err'; status.textContent = 'Netzwerkfehler: ' + e; }
}

// ── Network config ──
let _netPollTimer = null;

function startNetPoll() {
  stopNetPoll();
  _netPollTimer = setInterval(pollNetStatus, 3000);
}

function stopNetPoll() {
  if (_netPollTimer) { clearInterval(_netPollTimer); _netPollTimer = null; }
}

async function pollNetStatus() {
  try {
    const res = await fetch('/network-status');
    const d = await res.json();
    const dot = document.getElementById('net-dot');
    const txt = document.getElementById('net-status-text');
    if (d.running) {
      dot.className = 'net-dot on';
      const mins = Math.floor(d.uptime_s / 60);
      const secs = d.uptime_s % 60;
      txt.textContent = 'Empfängt (PID ' + d.pid + ', ' + mins + 'm' + secs + 's)';
    } else {
      dot.className = 'net-dot off';
      txt.textContent = d.exit_code != null ? 'Gestoppt (Exit ' + d.exit_code + ')' : 'Nicht aktiv';
    }
    if (d.config && !_netConfigLoaded) {
      _netConfigLoaded = true;
      document.getElementById('net-group').value = d.config.group || '239.255.77.77';
      document.getElementById('net-port').value = d.config.port || 4010;
      document.getElementById('net-unicast').checked = !!d.config.unicast;
      document.getElementById('net-rate').value = d.config.rate || 48000;
      document.getElementById('net-format').value = d.config.format || 's16';
    }
    // Populate interface dropdown (always update list, preserve selection)
    if (d.interfaces) {
      const sel = document.getElementById('net-iface');
      const savedIface = _netConfigLoaded ? sel.value : (d.config && d.config.iface || '');
      const prev = sel.value;
      sel.innerHTML = '<option value="">Alle (Standard)</option>';
      for (const iface of d.interfaces) {
        const opt = document.createElement('option');
        opt.value = iface.name;
        opt.textContent = iface.name + ' — ' + iface.ip;
        sel.appendChild(opt);
      }
      // Restore saved value (on first load use config, otherwise keep current)
      sel.value = _netConfigLoaded ? prev : savedIface;
      if (!sel.value && savedIface) {
        // Interface might not exist anymore, add it as option anyway
        const opt = document.createElement('option');
        opt.value = savedIface;
        opt.textContent = savedIface + ' (nicht gefunden)';
        sel.appendChild(opt);
        sel.value = savedIface;
      }
    }
    // Update listen info
    const listenEl = document.getElementById('net-listen-addr');
    if (d.config && listenEl) {
      const mode = d.config.unicast ? 'Unicast' : 'Multicast ' + (d.config.group || '239.255.77.77');
      const port = d.config.port || 4010;
      const host = d.hostname || '?';
      const ip = d.pi_ip || '?';
      const iface = d.config.iface ? ' (' + d.config.iface + ')' : '';
      const rate = (d.config.rate || 48000) / 1000 + 'kHz';
      const fmt = d.config.format || 's16';
      listenEl.textContent = mode + ':' + port + iface + ' • ' + rate + '/' + fmt + ' — ' + host + ' (' + ip + ')';
    }
  } catch(e) {}
}

async function saveNetConfig() {
  const cfg = {
    group: document.getElementById('net-group').value,
    port: parseInt(document.getElementById('net-port').value) || 4010,
    iface: document.getElementById('net-iface').value,
    unicast: document.getElementById('net-unicast').checked,
    rate: parseInt(document.getElementById('net-rate').value) || 48000,
    format: document.getElementById('net-format').value || 's16',
  };
  status.className = 'loading';
  status.textContent = 'Netzwerk-Konfiguration wird gespeichert…';
  try {
    const res = await fetch('/network-config', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify(cfg)
    });
    const data = await res.json();
    if (data.ok) { status.className = 'ok'; status.textContent = data.msg; }
    else { status.className = 'err'; status.textContent = 'Fehler: ' + data.msg; }
    pollNetStatus();
  } catch(e) { status.className = 'err'; status.textContent = 'Netzwerkfehler: ' + e; }
}

async function restartNet() {
  await saveNetConfig();
}

// ── Balance ──
const balSlider   = document.getElementById('balance-slider');
const balDisplay  = document.getElementById('bal-display');
const balBtn      = document.getElementById('balance-btn');
const balResetBtn = document.getElementById('balance-reset-btn');

function updateBalDisplay() {
  const v = parseInt(balSlider.value);
  if (v === 0) {
    balDisplay.textContent = 'Gleich';
  } else if (v < 0) {
    const front = 100, rear = 100 + v;
    balDisplay.textContent = 'Front ' + front + '% / Rear ' + rear + '%';
  } else {
    const front = 100 - v, rear = 100;
    balDisplay.textContent = 'Front ' + front + '% / Rear ' + rear + '%';
  }
}
balSlider.addEventListener('input', updateBalDisplay);
updateBalDisplay();

async function setBalance(val) {
  balBtn.disabled = true;
  status.className = 'loading';
  status.textContent = 'Balance wird gesetzt…';
  try {
    const res = await fetch('/balance', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({ balance: parseInt(val) })
    });
    const data = await res.json();
    if (data.ok) { status.className = 'ok'; status.textContent = data.msg; }
    else { status.className = 'err'; status.textContent = 'Fehler: ' + data.msg; }
  } catch(e) { status.className = 'err'; status.textContent = 'Netzwerkfehler: ' + e; }
  balBtn.disabled = false;
}

balBtn.addEventListener('click', () => setBalance(balSlider.value));
balResetBtn.addEventListener('click', () => {
  balSlider.value = 0;
  updateBalDisplay();
  setBalance(0);
});

