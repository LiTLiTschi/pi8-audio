    "best":  "bv+ba/b",
}

# ── Shared mutable state (all protected by _lock) ────────────────────────────
_lock   = threading.Lock()
_mpv_lock = threading.Lock()  # serialize mpv IPC — interleaved loadfile causes DRM glitches
_state  = {"mode": "off", "overlay_enabled": True, "visualizer_mirror": False,
           "visualizer_theme": "default",
