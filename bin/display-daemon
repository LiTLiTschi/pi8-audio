CONSOLE_VT = max(1, min(63, int(os.environ.get("PI8_CONSOLE_VT", "1"))))
BLANK_VT   = max(1, min(63, int(os.environ.get("PI8_BLANK_VT", "2"))))
if BLANK_VT == CONSOLE_VT:
